---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/explore.css';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projectCards = projects.map(({ data }) => ({
  title: data.title,
  status: data.status,
  stack: data.stack,
  summary: data.summary,
  contribution: data.contribution ?? '',
  link: data.link ?? '',
  linkLabel: data.linkLabel ?? 'OPEN PROJECT'
}));
---

<BaseLayout
  title="AjmalOS Aero Explorer"
  description="Boot the AjmalOS Aero Explorer, a Frutiger Aero portfolio exploration experience."
>
  <main class="explore-shell" data-explore-shell>
    <div class="explore-sky" aria-hidden="true">
      <span class="explore-orb explore-orb-one"></span>
      <span class="explore-orb explore-orb-two"></span>
      <span class="explore-cloud explore-cloud-one"></span>
      <span class="explore-cloud explore-cloud-two"></span>
      <span class="explore-horizon"></span>
    </div>

    <header class="explore-topbar">
      <a class="explore-brand" href="/" aria-label="Return to AjmalOS homepage">
        <span class="explore-brand-mark" aria-hidden="true">✦</span>
        <span><strong>AJMAL</strong><small>OS / AERO EXPLORER</small></span>
      </a>
      <div class="explore-topbar-actions">
        <span class="explore-status mono"><i aria-hidden="true"></i> LOCAL / READY</span>
        <a class="explore-return mono" href="/">RETURN TO AJMALOS ↗</a>
      </div>
    </header>

    <section class="explore-stage" aria-labelledby="explore-title">
      <div class="explore-glass-panel" data-boot-panel>
        <div class="explore-panel-header">
          <span class="mono">AJMALOS AERO SYSTEM</span>
          <span class="mono" data-panel-version>PHASE 01 / BOOT</span>
        </div>

        <div class="explore-panel-body">
          <div class="explore-emblem" aria-hidden="true">
            <span class="explore-emblem-ring"></span>
            <span class="explore-emblem-core">A</span>
          </div>
          <p class="explore-kicker mono">PERSONAL ARCHIVE / EXPLORATION MODE</p>
          <h1 id="explore-title">Welcome to the<br /><em>Aero Explorer.</em></h1>
          <p class="explore-lede">
            A future walk through Ajmal's real projects, systems, and build notes. The world is being
            assembled in phases; this boot room is the first checkpoint.
          </p>

          <div class="explore-initialization" aria-live="polite">
            <div class="explore-init-row">
              <span class="mono" data-init-message>DISPLAY CHECK / READY</span>
              <span class="mono" data-init-count>01 / 03</span>
            </div>
            <div class="explore-progress" role="progressbar" aria-label="Aero Explorer initialization" aria-valuemin="0" aria-valuemax="3" aria-valuenow="1">
              <span data-init-progress></span>
            </div>
            <div class="explore-progress-glow" aria-hidden="true"></div>
          </div>

          <div class="explore-actions">
            <button class="explore-start" type="button" data-start-exploring disabled>
              <span>START EXPLORING</span><b aria-hidden="true">↗</b>
            </button>
            <a class="explore-secondary mono" href="/">RETURN TO AJMALOS</a>
          </div>
          <p class="explore-hint mono">NO SOUND REQUIRED / KEYBOARD AND TOUCH FRIENDLY</p>
        </div>

        <div class="explore-panel-footer mono">
          <span data-init-footer>INITIALIZING LOCAL EXPERIENCE</span>
          <span>WEBGL OPTIONAL / STATIC FALLBACK AVAILABLE</span>
        </div>
      </div>

      <aside class="explore-system-card" aria-label="Explorer system information">
        <span class="mono">SYSTEM PROFILE</span>
        <strong>AJMALOS / AERO</strong>
        <p>Portfolio landmarks, interactive experiments, and the systems behind the work.</p>
        <div class="explore-system-detail"><span>MODE</span><b>EXPLORATION</b></div>
        <div class="explore-system-detail"><span>AUDIO</span><b>OFF BY DEFAULT</b></div>
        <div class="explore-system-detail"><span>MOTION</span><b data-motion-status>STANDARD</b></div>
      </aside>
    </section>

    <section class="explore-game" data-explore-game hidden aria-label="AjmalOS Aero Home Island exploration world">
      <div class="explore-game-stage">
        <canvas data-explore-canvas tabindex="0" aria-label="Playable home island. Use WASD or arrow keys to move."></canvas>
        <div class="explore-game-hud">
          <div class="explore-hud-title"><span class="mono">AJMALOS AERO / HOME ISLAND</span><strong data-explore-coordinates>HOME ISLAND / 560 : 820</strong><strong data-orb-counter>AERO ORBS: 0/10</strong></div>
          <div class="explore-hud-actions">
            <button type="button" class="explore-hud-button" data-menu-toggle aria-expanded="false">MENU</button>
            <span class="mono" data-explore-status>WASD / ARROWS TO MOVE · ESC TO PAUSE</span>
          </div>
          <p class="explore-controls-guide mono">MOVE: WASD / ARROWS · PAUSE: ESC · TOUCH: DIRECTION PAD</p>
        </div>
        <div class="explore-map" aria-label="Aero world map">
          <span class="mono">WORLD MAP</span><div class="explore-map-track"></div><i class="explore-map-player" data-map-player></i>
          <button type="button" class="explore-map-island map-home" data-map-island="home" aria-label="Home Island">HOME</button>
          <button type="button" class="explore-map-island map-robotics" data-map-island="robotics" aria-label="Robotics Island unavailable in this build" disabled>ROBOTICS</button>
          <button type="button" class="explore-map-island map-developer" data-map-island="developer" aria-label="Developer Island unavailable in this build" disabled>DEV</button>
        </div>
        <div class="explore-world-prompt" data-explore-prompt hidden>
          <span class="mono">LANDMARK DETECTED</span><strong data-explore-prompt-title>HOME TERMINAL</strong>
          <small data-explore-prompt-copy>Profile and quick navigation</small>
          <a data-explore-prompt-link href="/" hidden>OPEN LANDMARK / E OR TAP ↗</a>
        </div>
        <div class="explore-touch-controls" aria-label="Touch movement controls">
          <button type="button" data-touch="up" aria-label="Move up">▲</button>
          <div><button type="button" data-touch="left" aria-label="Move left">◀</button><button type="button" data-touch="down" aria-label="Move down">▼</button><button type="button" data-touch="right" aria-label="Move right">▶</button></div>
        </div>
        <div class="explore-game-menu" data-explore-menu hidden>
          <div class="explore-menu-card">
            <span class="explore-kicker mono">AERO EXPLORER / PAUSED</span>
            <h2>Home island</h2>
            <nav aria-label="Explorer menu">
              <button type="button" data-menu-item="portfolio">Portfolio</button>
              <button type="button" data-menu-item="map">Map</button>
              <button type="button" data-menu-item="inventory">Inventory</button>
              <a href="/">Exit to AjmalOS ↗</a>
            </nav>
            <p class="explore-menu-detail" data-menu-detail>Choose a destination.</p>
            <button type="button" class="explore-secondary mono" data-menu-close>RESUME EXPLORING</button>
          </div>
        </div>
        <div class="explore-landmark-modal" data-landmark-modal hidden aria-hidden="true">
          <div class="explore-landmark-card" role="dialog" aria-modal="true" aria-labelledby="landmark-title" aria-describedby="landmark-content">
            <button type="button" class="explore-modal-close" data-landmark-close aria-label="Close landmark panel">×</button>
            <span class="explore-kicker mono" data-landmark-kicker>PORTFOLIO TERMINAL / HOME ISLAND</span>
            <h2 id="landmark-title" data-landmark-title>Portfolio Terminal</h2>
            <div id="landmark-content" data-landmark-content>
              <p data-landmark-intro>Profile, introduction and quick navigation.</p>
              <div class="explore-landmark-actions">
                <a class="explore-start" href="/" data-landmark-home>OPEN AJMALOS ↗</a>
              </div>
            </div>
            <div class="explore-orb-toast" data-orb-toast hidden role="status" aria-live="polite"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="explore-fallback" data-explore-fallback hidden aria-live="assertive">
      <div class="explore-ready-card">
        <span class="explore-kicker mono">EXPLORER / SAFE MODE</span>
        <h2>The launch deck is still available.</h2>
        <p>The interactive shell could not initialize in this browser. Your portfolio archive is unaffected.</p>
        <a class="explore-start" href="/">RETURN TO AJMALOS ↗</a>
      </div>
    </section>

    <noscript>
      <div class="explore-noscript">
        <strong>JavaScript is required to start the explorer shell.</strong>
        <a href="/">RETURN TO AJMALOS ↗</a>
      </div>
    </noscript>
  </main>
</BaseLayout>

<script is:inline type="application/json" data-explore-projects set:html={JSON.stringify(projectCards)}></script>

<script>
  const shell = document.querySelector<HTMLElement>('[data-explore-shell]');
  const bootPanel = document.querySelector<HTMLElement>('[data-boot-panel]');
  const startButton = document.querySelector<HTMLButtonElement>('[data-start-exploring]');
  const fallbackPanel = document.querySelector<HTMLElement>('[data-explore-fallback]');
  const initMessage = document.querySelector<HTMLElement>('[data-init-message]');
  const initCount = document.querySelector<HTMLElement>('[data-init-count]');
  const initProgress = document.querySelector<HTMLElement>('[data-init-progress]');
  const initBar = document.querySelector<HTMLElement>('.explore-progress');
  const initFooter = document.querySelector<HTMLElement>('[data-init-footer]');
  const motionStatus = document.querySelector<HTMLElement>('[data-motion-status]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const game = document.querySelector<HTMLElement>('[data-explore-game]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-explore-canvas]');
  const menu = document.querySelector<HTMLElement>('[data-explore-menu]');
  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menuClose = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  const menuDetail = document.querySelector<HTMLElement>('[data-menu-detail]');
  const coordinates = document.querySelector<HTMLElement>('[data-explore-coordinates]');
  const prompt = document.querySelector<HTMLElement>('[data-explore-prompt]');
  const promptTitle = document.querySelector<HTMLElement>('[data-explore-prompt-title]');
  const promptCopy = document.querySelector<HTMLElement>('[data-explore-prompt-copy]');
  const promptLink = document.querySelector<HTMLAnchorElement>('[data-explore-prompt-link]');
  const landmarkModal = document.querySelector<HTMLElement>('[data-landmark-modal]');
  const landmarkClose = document.querySelector<HTMLButtonElement>('[data-landmark-close]');
  const landmarkTitle = document.querySelector<HTMLElement>('[data-landmark-title]');
  const landmarkKicker = document.querySelector<HTMLElement>('[data-landmark-kicker]');
  const landmarkContent = document.querySelector<HTMLElement>('[data-landmark-content]');
  const orbCounter = document.querySelector<HTMLElement>('[data-orb-counter]');
  const orbToast = document.querySelector<HTMLElement>('[data-orb-toast]');
  const mapPlayer = document.querySelector<HTMLElement>('[data-map-player]');
  const mapIslandButtons = document.querySelectorAll<HTMLButtonElement>('[data-map-island]');
  const projects = JSON.parse(document.querySelector<HTMLElement>('[data-explore-projects]')?.textContent ?? '[]') as Array<{ title: string; status: string; stack: string; summary: string; contribution: string; link: string; linkLabel: string }>;
  let latestProgress = { collectedOrbIds: [] as string[], discoveredSecretIds: [] as string[], bonusIslandUnlocked: false, completed: false };
  let renderInventory: (() => void) | undefined;
  let world: import('../components/explore/explore-world').ExploreWorld | undefined;
  let previousFocus: HTMLElement | null = null;
  const setMenu = (open: boolean) => {
    if (menu) menu.hidden = !open;
    menuToggle?.setAttribute('aria-expanded', String(open));
    world?.setPaused(open);
  };

  const showFallback = () => {
    if (bootPanel) bootPanel.hidden = true;
    if (game) game.hidden = true;
    world?.destroy();
    if (fallbackPanel) fallbackPanel.hidden = false;
    shell?.classList.add('is-fallback');
    fallbackPanel?.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true });
  };

  try {
    if (!shell || !bootPanel || !startButton || !initMessage || !initCount || !initProgress || !initBar || !initFooter) {
      showFallback();
      throw new Error('Aero Explorer boot controls are incomplete.');
    }

    const phases = [
      ['DISPLAY CHECK / READY', '01 / 03'],
      ['INPUT CHANNEL / READY', '02 / 03'],
      ['ARCHIVE GATE / READY', '03 / 03']
    ];

    if (reducedMotion && motionStatus) motionStatus.textContent = 'REDUCED';
    let phase = 0;
    let completed = false;
    const updatePhase = () => {
      const [message, count] = phases[phase];
      initMessage.textContent = message;
      initCount.textContent = count;
      initProgress.style.width = `${((phase + 1) / phases.length) * 100}%`;
      initBar.setAttribute('aria-valuenow', String(phase + 1));
    };
    const complete = () => {
      if (completed) return;
      completed = true;
      phase = phases.length - 1;
      updatePhase();
      startButton.disabled = false;
      initFooter.textContent = 'LOCAL EXPERIENCE READY / NO ASSETS DOWNLOADED';
      startButton.focus({ preventScroll: true });
    };

    phases.forEach((_, index) => {
      phase = index;
      updatePhase();
    });
    complete();

    startButton.addEventListener('click', () => {
      if (startButton.disabled) return;
      bootPanel.hidden = true;
      game?.removeAttribute('hidden');
      shell.classList.add('is-ready');
      try {
        if (!canvas || !coordinates || !prompt || !promptTitle || !promptCopy || !promptLink || !mapPlayer || !landmarkModal || !landmarkClose || !landmarkTitle || !landmarkKicker || !landmarkContent || !orbCounter || !orbToast) throw new Error('Explorer canvas controls are incomplete.');
        const openLandmark = (landmark: import('../components/explore/world-data').ExploreLandmark) => {
          previousFocus = document.activeElement instanceof HTMLElement && document.activeElement !== document.body ? document.activeElement : canvas;
          landmarkTitle.textContent = landmark.label;
          landmarkKicker.textContent = `${landmark.label} / HOME ISLAND`;
          if (landmark.id === 'completion') {
            landmarkContent.innerHTML = '<p>Every Aero orb is now in your archive. The home island is fully mapped, and your exploration log is complete.</p><div class="explore-landmark-actions"><a class="explore-start" href="/">RETURN TO AJMALOS ↗</a></div>';
          } else if (landmark.id === 'hidden-grotto' || landmark.id === 'developer-signal' || landmark.id === 'waybionic-detail') {
            landmarkContent.innerHTML = `<p>${landmark.copy}</p><p class="explore-project-contribution">This discovery has been added to your local exploration log. Revisit the island any time to continue exploring.</p>`;
          } else if (landmark.id === 'projects-gateway') {
            landmarkContent.innerHTML = `<p>Real projects from the AjmalOS archive, using the existing project collection.</p><div class="explore-project-list">${projects.map((project) => `<article class="explore-project-card"><span class="mono">${project.status} / ${project.stack}</span><h3>${project.title}</h3><p>${project.summary}</p><p class="explore-project-contribution">${project.contribution}</p>${project.link ? `<a href="${project.link}" target="_blank" rel="noreferrer">${project.linkLabel} ↗</a>` : ''}</article>`).join('')}</div>`;
          } else if (landmark.id === 'contact-station') {
            landmarkContent.innerHTML = '<p>Reach Ajmal through the same contact paths available in the standard AjmalOS interface.</p><div class="explore-landmark-actions"><a class="explore-start" href="mailto:khidri.ajmal@gmail.com">EMAIL AJMAL ↗</a><a class="explore-secondary mono" href="https://www.linkedin.com/in/ajmal-khidri/" target="_blank" rel="noreferrer">LINKEDIN ↗</a><a class="explore-secondary mono" href="https://scholar.google.com/citations?hl=en&tzom=360&user=-3vElwEAAAAJ" target="_blank" rel="noreferrer">GOOGLE SCHOLAR ↗</a></div>';
          } else {
            landmarkContent.innerHTML = '<p>Profile, biography, experience and quick navigation remain available in the original AjmalOS archive.</p><div class="explore-landmark-actions"><a class="explore-start" href="/">OPEN AJMALOS ↗</a></div>';
          }
          landmarkModal.hidden = false;
          landmarkModal.setAttribute('aria-hidden', 'false');
          setMenu(false);
          world?.setPaused(true);
          landmarkClose.focus({ preventScroll: true });
        };
        renderInventory = () => {
          landmarkTitle.textContent = 'Aero Inventory';
          landmarkKicker.textContent = 'INVENTORY / EXPLORATION PROGRESS';
          landmarkContent.innerHTML = `<p>AERO ORBS: ${latestProgress.collectedOrbIds.length}/10</p><p>DISCOVERED SECRETS: ${latestProgress.discoveredSecretIds.length}/3</p><p>${latestProgress.bonusIslandUnlocked ? 'BONUS ISLAND UNLOCKED — new destinations can be connected in a later world pass.' : `Collect ${Math.max(0, 5 - latestProgress.collectedOrbIds.length)} more orb${5 - latestProgress.collectedOrbIds.length === 1 ? '' : 's'} to unlock the bonus-island milestone.`}</p><p class="mono">${latestProgress.completed ? 'EXPLORATION LOG COMPLETE' : 'PROGRESS SAVES LOCALLY WHEN STORAGE IS AVAILABLE'}</p><button type="button" class="explore-secondary mono" data-reset-progress>RESET SAVED PROGRESS</button>`;
          landmarkModal.hidden = false;
          landmarkModal.setAttribute('aria-hidden', 'false');
          setMenu(false);
          world?.setPaused(true);
          landmarkClose.focus({ preventScroll: true });
          landmarkContent.querySelector<HTMLButtonElement>('[data-reset-progress]')?.addEventListener('click', () => {
            if (!window.confirm('Reset all collected orbs and discovered secrets?')) return;
            world?.resetProgress();
            renderInventory?.();
          });
        };
        import('../components/explore/explore-world').then(({ ExploreWorld }) => {
          world = new ExploreWorld({ canvas, coordinates, prompt, promptTitle, promptCopy, promptLink, mapPlayer, mapIslandButtons, reduced: reducedMotion, onMenuToggle: setMenu, onLandmarkOpen: openLandmark, onProgressChange: (state) => {
            latestProgress = state;
            orbCounter.textContent = `AERO ORBS: ${state.collectedOrbIds.length}/10`;
          }, onOrbCollected: (orb) => {
            orbToast.textContent = `${orb.label} collected · AERO ORBS ${latestProgress.collectedOrbIds.length}/10`;
            orbToast.hidden = false;
            window.setTimeout(() => { orbToast.hidden = true; }, 2400);
            if (latestProgress.completed) openLandmark({ id: 'completion', island: 'home', label: 'AERO COMPLETE', copy: 'All ten Aero orbs discovered.', x: 0, y: 0, color: '#fff7bc' });
          }, onSecretDiscovered: (secret) => {
            openLandmark({ id: secret.id, island: secret.island, label: secret.label, copy: secret.copy, x: 0, y: 0, color: '#fff7bc' });
          } });
          world.start();
        }).catch(showFallback);
      } catch {
        showFallback();
      }
    });
    menuToggle?.addEventListener('click', () => setMenu(menu?.hidden ?? true));
    menuClose?.addEventListener('click', () => setMenu(false));
    const closeLandmark = () => {
      if (!landmarkModal) return;
      landmarkModal.hidden = true;
      landmarkModal.setAttribute('aria-hidden', 'true');
      setMenu(false);
      if (menu) menu.hidden = true;
      menuToggle?.setAttribute('aria-expanded', 'false');
      world?.setPaused(false);
      (previousFocus ?? canvas)?.focus({ preventScroll: true });
    };
    landmarkClose?.addEventListener('click', closeLandmark);
    promptLink?.addEventListener('click', (event) => { event.preventDefault(); world?.interactNearby(); });
    window.addEventListener('keydown', (event) => {
      if (landmarkModal && !landmarkModal.hidden && event.key === 'Tab') {
        const focusable = [...landmarkModal.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])')];
        if (focusable.length === 0) {
          event.preventDefault();
          landmarkClose?.focus({ preventScroll: true });
        } else if (event.shiftKey && document.activeElement === focusable[0]) {
          event.preventDefault();
          focusable.at(-1)?.focus({ preventScroll: true });
        } else if (!event.shiftKey && document.activeElement === focusable.at(-1)) {
          event.preventDefault();
          focusable[0]?.focus({ preventScroll: true });
        }
      }
      if (event.key === 'Escape' && landmarkModal && !landmarkModal.hidden) {
        event.preventDefault();
        event.stopImmediatePropagation();
        closeLandmark();
      }
    }, true);
    document.querySelectorAll<HTMLButtonElement>('[data-menu-item]').forEach((item) => item.addEventListener('click', () => {
      if (item.dataset.menuItem === 'inventory') {
        renderInventory?.();
        return;
      }
      if (menuDetail) menuDetail.textContent = item.dataset.menuItem === 'portfolio'
        ? 'Use a landmark sign to open the existing AjmalOS archive.'
        : item.dataset.menuItem === 'map'
          ? 'Home Island is playable now. Robotics and Developer Islands are planned destinations.'
          : 'Collect orbs and revisit landmarks to update your local exploration log.';
    }));
    mapIslandButtons.forEach((button) => button.addEventListener('click', () => {
      menuDetail && (menuDetail.textContent = `${button.textContent} is reachable by following the glowing route.`);
      setMenu(true);
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-touch]').forEach((button) => {
      const direction = button.dataset.touch as 'up' | 'down' | 'left' | 'right';
      button.addEventListener('pointerdown', () => { canvas?.focus(); world?.press(direction); });
      button.addEventListener('pointerup', () => world?.release(direction));
      button.addEventListener('pointercancel', () => world?.release(direction));
    });
    window.addEventListener('pagehide', () => world?.destroy(), { once: true });
  } catch {
    showFallback();
  }
</script>
