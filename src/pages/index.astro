---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import WorkcellHero from '../components/site/WorkcellHero.astro';
import RoverSonarSim from '../components/site/RoverSonarSim.astro';
import PoissonExplorer from '../components/site/PoissonExplorer.astro';
import GithubPulse from '../components/site/GithubPulse.astro';
import SiteTerminal from '../components/site/SiteTerminal.astro';
import StaleStateLab from '../components/StaleStateLab.astro';
import BlackBoxDemo from '../components/BlackBoxDemo.astro';
import SnakeRewardLab from '../components/SnakeRewardLab.astro';
import HvacSimulator from '../components/HvacSimulator.astro';
import { awards, certifications, contact, coursework, education, offline, roadmap, roles, skills } from '../data/profile';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const projects = all.filter((entry) => entry.data.group);

const groups = [
  { id: 'robotics', name: 'Robotics and physical systems', blurb: 'Software that commands, watches, or records something in the real world.' },
  { id: 'software', name: 'Software and data', blurb: 'Hackathon builds and data products, each scoped honestly as a prototype.' },
  { id: 'business', name: 'Businesses', blurb: 'Two operations where the customer sees the result the same day.' }
] as const;

const statusWord: Record<string, string> = { ACTIVE: 'Active', 'IN PROGRESS': 'In progress', PROTOTYPE: 'Prototype', SHIPPED: 'Shipped' };
const titleCase = (stack: string) => stack.split(' / ').map((item) => item.trim());
const shortTitle = (title: string) => title.split(' — ')[0];

const projectNames: Record<string, string> = Object.fromEntries(all.map((entry) => [entry.id, shortTitle(entry.data.title)]));
projectNames.portfolio = 'This site';
projectNames.coursework = 'Coursework';
projectNames['robotics-roadmap'] = 'Roadmap';

const skillGroups = [...new Set(skills.map((skill) => skill.group))].map((group) => ({
  group,
  items: skills.filter((skill) => skill.group === group)
}));

const facts = [
  { value: String(projects.length), label: 'projects documented on this page' },
  { value: String(roles.length), label: 'current and past roles' },
  { value: '$10k+', label: 'in scholarships and grants' },
  { value: '2', label: "Dean's Lists, at two universities" }
];
---

<SiteLayout>
  <header class="topbar" data-topbar>
    <a class="mark" href="#top" aria-label="Back to top">AK</a>
    <nav aria-label="Sections">
      <a href="#work">Work</a>
      <a href="#thinking">Thinking</a>
      <a href="#experience">Experience</a>
      <a href="#toolbox">Toolbox</a>
      <a href="#next">Next</a>
      <a href="#contact">Contact</a>
    </nav>
    <a class="btn btn-small" href={contact.resume} download>Resume</a>
  </header>

  <main id="top">
    <WorkcellHero />

    <section class="thread paper" id="thread" data-term-target aria-labelledby="thread-title">
      <div class="shell thread-grid">
        <h2 id="thread-title" class="thread-title" data-reveal>Compressors.<br />Nozzles.<br />Joints.</h2>
        <div class="thread-copy" data-reveal>
          <p class="lead">Most student portfolios are a list of apps. Mine keeps returning to machines that have to keep running while someone depends on them.</p>
          <ol class="thread-list">
            <li><strong>HVAC Express</strong><span>Since March 2024 I've run the website, hosting, and lead generation for a family heating and cooling company, and sold its service face to face.</span></li>
            <li><strong>Chinook Clean</strong><span>I own a power-washing business: pumps, nozzles, quotes, schedules, and a result the customer judges on the spot.</span></li>
            <li><strong>WayBionic Robotics</strong><span>Since August 2026 I've written movement-test panels and diagnostics for a ROS 2 ground station that drives a surgical arm.</span></li>
          </ol>
        </div>
        <dl class="facts" data-reveal>
          {facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
        </dl>
      </div>
    </section>

    <section class="work paper" id="work" data-term-target aria-labelledby="work-title">
      <div class="shell work-head" data-reveal>
        <h2 id="work-title" class="section-title">The work</h2>
        <p class="section-intro">Every entry states the problem, the system, the decision that shaped it, and what's next. Status labels are honest: a prototype says prototype. Six of them include something you can run right here.</p>
      </div>

      <div class="shell work-layout">
        <nav class="rail" aria-label="Projects">
          {groups.map((group) => (
            <div class="rail-group">
              <p>{group.name}</p>
              <ul>
                {projects.filter((entry) => entry.data.group === group.id).map((entry) => (
                  <li><a href={`#${entry.id}`} data-rail-link={entry.id}><span>{shortTitle(entry.data.title)}</span><em data-status={entry.data.status}>{statusWord[entry.data.status]}</em></a></li>
                ))}
              </ul>
            </div>
          ))}
        </nav>

        <div class="cases">
          {groups.map((group) => (
            <div class="case-group" id={`group-${group.id}`}>
              <div class="group-head" data-reveal>
                <h3>{group.name}</h3>
                <p>{group.blurb}</p>
              </div>
              {projects.filter((entry) => entry.data.group === group.id).map((entry) => {
                const data = entry.data;
                return (
                  <article class="case" id={entry.id} data-case={entry.id} aria-labelledby={`${entry.id}-title`}>
                    <header class="case-head" data-reveal>
                      <div class="case-meta">
                        <span class="tag" data-status={data.status}>{statusWord[data.status]}</span>
                        {data.year ? <span>{data.year}</span> : null}
                        {data.role ? <span>{data.role}</span> : null}
                      </div>
                      <h4 class="case-title" id={`${entry.id}-title`} data-case-title>{data.title}</h4>
                      <p class="case-summary">{data.summary}</p>
                    </header>

                    <div class="case-body" data-reveal>
                      <dl class="case-facts">
                        {data.problem ? <div><dt>Problem</dt><dd>{data.problem}</dd></div> : null}
                        {data.system ? <div><dt>{data.status === 'SHIPPED' || data.status === 'ACTIVE' ? 'System' : 'Current design'}</dt><dd>{data.system}</dd></div> : null}
                        {data.decision ? <div><dt>Key decision</dt><dd>{data.decision}</dd></div> : null}
                        {data.contribution ? <div><dt>My part</dt><dd>{data.contribution}</dd></div> : null}
                        {data.next ? <div><dt>Next</dt><dd>{data.next}</dd></div> : null}
                      </dl>
                      <aside class="case-side">
                        {data.highlights?.length ? (
                          <ul class="case-highlights">{data.highlights.map((item) => <li>{item}</li>)}</ul>
                        ) : null}
                        <ul class="stack" aria-label="Stack">{titleCase(data.stack).map((item) => <li>{item}</li>)}</ul>
                        {data.link ? <a class="case-link" href={data.link} target="_blank" rel="noreferrer">{(data.linkLabel ?? 'View project').toLowerCase().replace(/^\w/, (c) => c.toUpperCase())}</a> : null}
                      </aside>
                    </div>

                    {entry.id === 'waybionic-ground-station' ? (
                      <div class="case-instruments" data-reveal>
                        <div class="evidence-pair">
                          <figure><img src="/assets/waybionic/engineer-monitor-normal.png" alt="WayBionic engineering monitor in RViz showing a mock normal joint state." loading="lazy" decoding="async" /><figcaption>Mock normal state, RViz</figcaption></figure>
                          <figure><img src="/assets/waybionic/engineer-monitor-fault.png" alt="WayBionic engineering monitor in RViz flagging a mock fault and stale state." loading="lazy" decoding="async" /><figcaption>Mock fault and stale state</figcaption></figure>
                        </div>
                        <div class="instrument-wrap"><StaleStateLab /></div>
                        <figure class="video-frame">
                          <video controls playsinline preload="none" poster="/assets/waybionic/engineer-monitor-normal.png"><source src="/assets/waybionic/arm-demo.mp4" type="video/mp4" />Your browser can't play this video. <a href="/assets/waybionic/arm-demo.mp4">Download the MP4</a>.</video>
                          <figcaption>The team's arm moving. Captures are mock RViz states; nothing on this page connects to ROS or sends hardware commands.</figcaption>
                        </figure>
                      </div>
                    ) : null}
                    {entry.id === 'physical-ai-blackbox' ? <div class="case-instruments" data-reveal><div class="instrument-wrap"><BlackBoxDemo /></div></div> : null}
                    {entry.id === 'autonomous-rover' ? <div class="case-instruments" data-reveal><RoverSonarSim /></div> : null}
                    {entry.id === 'teach-to-game' ? <div class="case-instruments" data-reveal><div class="instrument-wrap"><SnakeRewardLab /></div></div> : null}
                    {entry.id === 'soccer-intelligence' ? <div class="case-instruments" data-reveal><PoissonExplorer /></div> : null}
                    {entry.id === 'hvac-express' ? <div class="case-instruments" data-reveal><div class="instrument-wrap"><HvacSimulator /></div></div> : null}
                    {entry.id === 'southpoint' ? (
                      <div class="case-instruments" data-reveal>
                        <div class="instrument arch">
                          <div class="instrument-head"><span class="instrument-title">Architecture</span><span class="instrument-chip">from the team README</span></div>
                          <div class="arch-cols">
                            <div><p>Front end</p><ul><li>2D map: sun, shadows, rims</li><li>Sky dome and sun slider</li><li>3D surface, react-three-fiber</li><li>Compare and mission panel</li></ul></div>
                            <div class="arch-link" aria-hidden="true"><span>REST / JSON</span></div>
                            <div><p>FastAPI back end</p><ul><li>ephemeris.py: Skyfield + DE421</li><li>terrain.py: LOLA DEM</li><li>scoring.py: heuristic status</li><li>mission.py: illustrative plan</li></ul></div>
                          </div>
                        </div>
                      </div>
                    ) : null}
                    {entry.id === 'aircade' ? (
                      <div class="case-instruments" data-reveal>
                        <div class="instrument arch">
                          <div class="instrument-head"><span class="instrument-title">Motion input path</span><span class="instrument-chip">not yet validated end to end</span></div>
                          <ol class="flow">
                            <li><strong>AirPods / iPhone</strong><span>CoreMotion samples</span></li>
                            <li><strong>Swift sender</strong><span>normalise and stream</span></li>
                            <li><strong>Local relay</strong><span>WebSocket</span></li>
                            <li><strong>Browser game</strong><span>per-game mapping</span></li>
                          </ol>
                          <ul class="games"><li>Pong</li><li>Snake</li><li>Breakout</li><li>Bowling</li><li>Tanks</li></ul>
                        </div>
                      </div>
                    ) : null}
                    {entry.id === 'proofly' ? (
                      <div class="case-instruments" data-reveal>
                        <div class="instrument arch">
                          <div class="instrument-head"><span class="instrument-title">From community work to a credential</span><span class="instrument-chip">fictional demo data</span></div>
                          <ol class="flow">
                            <li><strong>Project</strong><span>student logs the work</span></li>
                            <li><strong>Vouch</strong><span>community member confirms</span></li>
                            <li><strong>Review</strong><span>simulated coordinator</span></li>
                            <li><strong>Sign</strong><span>Ed25519 credential</span></li>
                            <li><strong>Verify</strong><span>employer lens, issuer allowlist</span></li>
                          </ol>
                        </div>
                      </div>
                    ) : null}
                    {entry.id === 'chinook-clean' ? (
                      <div class="case-instruments" data-reveal>
                        <div class="instrument arch">
                          <div class="instrument-head"><span class="instrument-title">How a job runs</span><span class="instrument-chip">owner-operated</span></div>
                          <ol class="flow">
                            <li><strong>Conversation</strong><span>what the customer wants cleaned</span></li>
                            <li><strong>Quote</strong><span>surface, access, time</span></li>
                            <li><strong>Schedule</strong><span>weather and equipment</span></li>
                            <li><strong>Wash</strong><span>on site, by hand</span></li>
                            <li><strong>Walkthrough</strong><span>the customer checks the result</span></li>
                          </ol>
                        </div>
                      </div>
                    ) : null}
                  </article>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="thinking night" id="thinking" data-term-target aria-labelledby="thinking-title">
      <div class="shell">
        <div class="thinking-head" data-reveal>
          <h2 id="thinking-title" class="section-title">How I make a call</h2>
          <p class="section-intro">One real decision from WayBionic, annotated. The arm is surgical hardware; the ground station is the first place a mistake would show up.</p>
        </div>
        <div class="decision" data-reveal>
          <pre class="decision-code" aria-label="Illustrative ground-station launch parameters"><code><span class="ln">1</span><span class="c"># ground station launch: how the decision reads as config</span>
<span class="ln">2</span><span class="k">drives</span>:
<span class="ln">3</span>  <span class="k">source</span>: <span class="v">simulated</span>        <span class="c"># MKS CAN drives</span>
<span class="ln">4</span>  <span class="k">live_hardware</span>: <span class="v">opt_in</span>
<span class="ln">5</span><span class="k">diagnostics_panel</span>:
<span class="ln">6</span>  <span class="k">mode</span>: <span class="v">monitor_only</span>     <span class="c"># never commands</span>
<span class="ln">7</span>  <span class="k">flag</span>: [<span class="v">stale</span>, <span class="v">future_dated</span>, <span class="v">error</span>]
<span class="ln">8</span><span class="k">joint_state</span>:
<span class="ln">9</span>  <span class="k">label</span>: <span class="v">commanded | estimated | measured</span>
<span class="ln">10</span><span class="k">motion</span>:
<span class="ln">11</span>  <span class="k">checks</span>: [<span class="v">joint_limits</span>, <span class="v">collision</span>]</code></pre>
          <ol class="decision-notes">
            <li><strong>Simulation is the default.</strong> Motion tests publish to a simulated joint-state driver. Touching the real arm is a deliberate opt-in, not the path you fall into.</li>
            <li><strong>The monitor watches; it never drives.</strong> Keeping the diagnostics panel read-only means a UI bug can mislead an operator but cannot move a joint.</li>
            <li><strong>Old data must look old.</strong> A stale value that still looks current is worse than no value. Stale and future-dated samples are flagged in RViz.</li>
            <li><strong>Say where a number came from.</strong> Commanded, estimated, and measured positions are kept apart until actuator names and units are confirmed on the real model.</li>
          </ol>
        </div>
        <p class="fine" data-reveal>The config block paraphrases the decision for reading; it is not copied from the team repository.</p>
      </div>
    </section>

    <section class="experience paper" id="experience" data-term-target aria-labelledby="experience-title">
      <div class="shell">
        <h2 id="experience-title" class="section-title" data-reveal>Experience</h2>
        <div class="exp-grid">
          <ol class="timeline">
            {roles.map((role) => (
              <li data-kind={role.kind} data-reveal>
                <p class="when">{role.start} to {role.end}</p>
                <h3>{role.title}</h3>
                <p class="org">{role.org}</p>
                <ul>{role.points.map((point) => <li>{point}</li>)}</ul>
              </li>
            ))}
          </ol>
          <aside class="exp-side">
            <div class="exp-block" data-reveal>
              <h3>Education</h3>
              {education.map((item) => (
                <div class="edu">
                  <p class="edu-school">{item.school}</p>
                  <p>{item.credential}</p>
                  <p class="when">{item.when}</p>
                  <ul>{item.notes.map((note) => <li>{note}</li>)}</ul>
                </div>
              ))}
            </div>
            <div class="exp-block" data-reveal>
              <h3>Awards</h3>
              <ul class="plain">{awards.map((award) => <li><strong>{award.name}</strong><span>{award.detail}</span></li>)}</ul>
            </div>
            <div class="exp-block" data-reveal>
              <h3>Certifications</h3>
              <ul class="plain">{certifications.map((cert) => <li><strong>{cert.name}</strong><span>{cert.issuer}, {cert.when}</span></li>)}</ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="toolbox paper-deep" id="toolbox" data-term-target aria-labelledby="toolbox-title">
      <div class="shell">
        <div class="toolbox-head" data-reveal>
          <h2 id="toolbox-title" class="section-title">Toolbox</h2>
          <p class="section-intro">No skill bars. Each tool is listed with the projects on this page where it was actually used, so you can check. Hatched entries are on the roadmap and still being learned.</p>
        </div>
        <div class="skill-groups">
          {skillGroups.map(({ group, items }) => (
            <div class="skill-group" data-reveal>
              <h3>{group}</h3>
              <ul>
                {items.map((skill) => (
                  <li class:list={['skill', { learning: skill.learning }]}>
                    <span class="skill-name">{skill.name}</span>
                    <span class="skill-used">
                      {skill.used.map((id) => projects.some((entry) => entry.id === id)
                        ? <a href={`#${id}`}>{projectNames[id] ?? id}</a>
                        : <span>{id === 'robotics-roadmap' ? 'Roadmap' : projectNames[id] ?? id}</span>)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="next night" id="next" data-term-target aria-labelledby="next-title">
      <div class="shell">
        <div class="next-head" data-reveal>
          <h2 id="next-title" class="section-title">Where this is heading</h2>
          <p class="section-intro">The goal is a robotics company that ships machines into the real world. The plan builds the skills in simulation first, so none of it waits on buying hardware.</p>
        </div>
        <ol class="route" data-reveal>
          {roadmap.map((stop, index) => (
            <li data-state={stop.state}>
              <span class="route-step">{index + 1}</span>
              <p class="route-state">{stop.state === 'current' ? 'Now' : stop.state === 'stretch' ? 'Stretch goal' : 'Queued'}</p>
              <h3>{stop.tool}</h3>
              <p class="route-skill">{stop.skill}</p>
              <p>{stop.why}</p>
            </li>
          ))}
        </ol>

        <article class="research" data-reveal>
          <div>
            <p class="research-kind">Personal research, 27-page design study and preprint</p>
            <h3>Science fiction, with numbers attached</h3>
            <p>A feasibility assessment of a metre-scale confined-plasma cutting blade, modelled as a sheared-flow-stabilised screw pinch. The study separates what current plasma physics supports from the gaps that still block a handheld system.</p>
          </div>
          <dl>
            <div><dt>Physics</dt><dd>Confined plasma, Z-pinch feasibility</dd></div>
            <div><dt>Gaps found</dt><dd>Compact power density; keeping ambient air out</dd></div>
            <div><dt>Why it matters</dt><dd>Modelling and honest limits instead of hand-waving</dd></div>
          </dl>
          <a class="case-link" href={contact.scholar} target="_blank" rel="noreferrer">Google Scholar profile</a>
        </article>
      </div>
    </section>

    <section class="activity paper" id="activity" data-term-target aria-labelledby="activity-title">
      <div class="shell activity-grid">
        <div data-reveal>
          <h2 id="activity-title" class="section-title">Recent activity</h2>
          <p class="section-intro">Pulled from GitHub when the page loads, with a dated snapshot as the fallback.</p>
          <GithubPulse />
        </div>
        <div data-reveal>
          <h3 class="minor-title">Smaller builds and coursework</h3>
          <ul class="coursework">
            {coursework.map((item) => (
              <li>
                <p><strong>{item.link ? <a href={item.link} target="_blank" rel="noreferrer">{item.name}</a> : item.name}</strong><span>{item.stack}</span></p>
                <p>{item.detail}</p>
              </li>
            ))}
          </ul>
          <h3 class="minor-title">Off the clock</h3>
          <ul class="offline">{offline.map((item) => <li><strong>{item.title}</strong><span>{item.detail}</span></li>)}</ul>
        </div>
      </div>
    </section>

    <section class="contact night" id="contact" data-term-target aria-labelledby="contact-title">
      <div class="shell">
        <h2 id="contact-title" class="contact-title" data-reveal>Let's build<br />something that moves.</h2>
        <p class="contact-copy" data-reveal>Looking for software and robotics internships in Canada and the US. The fastest way to reach me is email.</p>
        <a class="contact-email" href={`mailto:${contact.email}`} data-reveal>{contact.email}</a>
        <ul class="contact-links" data-reveal>
          <li><a href={contact.resume} download>Resume (PDF)</a></li>
          <li><a href={contact.github} target="_blank" rel="noreferrer">GitHub</a></li>
          <li><a href={contact.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></li>
          <li><a href="/os">Boot the classic AjmalOS desktop</a></li>
        </ul>
      </div>
      <footer class="footer shell">
        <span>Ajmal Khidri, Calgary</span>
        <span>Built with Astro and Three.js. The arm above is solved in your browser.</span>
      </footer>
    </section>
  </main>

  <SiteTerminal />
</SiteLayout>

<script>
  // Top bar turns solid once the hero is behind it.
  const topbar = document.querySelector<HTMLElement>('[data-topbar]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (topbar && hero) {
    const sync = () => topbar.classList.toggle('is-solid', hero.getBoundingClientRect().bottom < topbar.offsetHeight);
    window.addEventListener('scroll', sync, { passive: true });
    sync();
  }

  // Project rail tracks the case in view.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')].map((link) => [link.dataset.railLink, link]));
  const spy = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      links.forEach((link) => link.removeAttribute('aria-current'));
      links.get((entry.target as HTMLElement).dataset.case)?.setAttribute('aria-current', 'true');
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('[data-case]').forEach((node) => spy.observe(node));
</script>
