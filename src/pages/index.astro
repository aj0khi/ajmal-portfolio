  <dialog class="kiosk" id="kiosk-stale-lab" aria-label="When fresh data goes stale"><button type="button" class="kiosk-close" data-kiosk-close>Close</button><div class="instrument-wrap"><StaleStateLab /></div></dialog>
  <dialog class="kiosk" id="kiosk-motor-bus" aria-label="Plan the arm bus"><button type="button" class="kiosk-close" data-kiosk-close>Close</button><MotorBusKiosk /></dialog>
  <dialog class="kiosk" id="kiosk-hash-chain" aria-label="Change one record"><button type="button" class="kiosk-close" data-kiosk-close>Close</button><div class="instrument-wrap"><BlackBoxDemo /></div></dialog>
  <dialog class="kiosk kiosk-wide" id="kiosk-snake-lab" aria-label="Train a policy yourself"><button type="button" class="kiosk-close" data-kiosk-close>Close</button><div class="instrument-wrap"><SnakeRewardLab /></div></dialog>
  <dialog class="kiosk kiosk-wide" id="kiosk-rover-sim" aria-label="Drop an obstacle"><button type="button" class="kiosk-close" data-kiosk-close>Close</button><RoverSonarSim /></dialog>
  <dialog class="kiosk" id="kiosk-poisson" aria-label="Expected goals in, outcomes out"><button type="button" class="kiosk-close" data-kiosk-close>Close</button><PoissonExplorer /></dialog>
