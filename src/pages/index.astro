---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import RoverSonarSim from '../components/site/RoverSonarSim.astro';
import PoissonExplorer from '../components/site/PoissonExplorer.astro';
import GithubPulse from '../components/site/GithubPulse.astro';
import SiteTerminal from '../components/site/SiteTerminal.astro';
import MotorBusKiosk from '../components/site/MotorBusKiosk.astro';
import SignatureKiosk from '../components/site/SignatureKiosk.astro';
import StaleStateLab from '../components/StaleStateLab.astro';
import BlackBoxDemo from '../components/BlackBoxDemo.astro';
import SnakeRewardLab from '../components/SnakeRewardLab.astro';
import HvacSimulator from '../components/HvacSimulator.astro';
import { awards, certifications, contact, coursework, education, offline, pastSocieties, roadmap, roles, skills, societies } from '../data/profile';
import { tour } from '../data/exhibits';

const entries = new Map((await getCollection('projects')).map((entry) => [entry.id, entry]));
const exhibits = tour.map((exhibit) => ({ ...exhibit, entry: entries.get(exhibit.id)! }));

const statusWord: Record<string, string> = { ACTIVE: 'Active', 'IN PROGRESS': 'In progress', PROTOTYPE: 'Prototype', SHIPPED: 'Shipped' };
const stackList = (stack: string) => stack.split(' / ').map((item) => item.trim());
const shortTitle = (title: string) => title.split(' — ')[0];
const sentence = (label: string) => label.toLowerCase().replace(/^\w/, (c) => c.toUpperCase());
const skillsFor = (id: string) => skills.filter((skill) => skill.used.includes(id) && !skill.learning);

const projectNames: Record<string, string> = Object.fromEntries([...entries].map(([id, entry]) => [id, shortTitle(entry.data.title)]));
projectNames.portfolio = 'This site';
projectNames.coursework = 'Coursework';
projectNames['robotics-roadmap'] = 'Roadmap';
const onTour = new Set(tour.map((exhibit) => exhibit.id));

const skillGroups = [...new Set(skills.map((skill) => skill.group))].map((group) => ({ group, items: skills.filter((skill) => skill.group === group) }));

const armJoints = [
  { name: 'old_arm_base_yaw_joint', label: 'base_yaw', min: -0.585, max: 4.128, value: 1.2 },
  { name: 'old_arm_shoulder_pitch_joint', label: 'shoulder_pitch', min: 0, max: 1.963, value: 0.6 },
  { name: 'old_arm_elbow_pitch_joint', label: 'elbow_pitch', min: -1.073, max: 2.068, value: 0.6 },
  { name: 'old_arm_wrist_roll_joint', label: 'wrist_roll', min: -0.48, max: 4.232, value: 1.5 }
];
// The annotated decision: each line names the note that explains it, and the pin marks where
// that note's lines start, so reading a note lights the config it describes.
const decisionLines: { html: string; note?: string; pin?: boolean }[] = [
  { html: '<span class="c"># ground station launch: how the decision reads as config</span>' },
  { html: '<span class="k">drives</span>:', note: '1' },
  { html: '  <span class="k">source</span>: <span class="v">simulated</span>        <span class="c"># MKS CAN drives</span>', note: '1', pin: true },
  { html: '  <span class="k">live_hardware</span>: <span class="v">opt_in</span>', note: '1' },
  { html: '<span class="k">diagnostics</span>:' },
  { html: '  <span class="k">mode</span>: <span class="v">monitor_only</span>     <span class="c"># never commands</span>', note: '2', pin: true },
  { html: '  <span class="k">flag</span>: [<span class="v">stale</span>, <span class="v">future_dated</span>, <span class="v">error</span>]', note: '3', pin: true },
  { html: '  <span class="k">merge</span>: <span class="v">per_publisher</span>    <span class="c"># one sensor can\'t hide another\'s fault</span>', note: '4', pin: true },
  { html: '<span class="k">joint_state</span>:' },
  { html: '  <span class="k">label</span>: <span class="v">commanded | estimated | measured</span>' },
  { html: '<span class="k">motion</span>:' },
  { html: '  <span class="k">checks</span>: [<span class="v">joint_limits</span>, <span class="v">collision</span>]' }
];

// Headings split into words so each can rise out of its own mask when the room arrives.
const words = (text: string) => text.split(' ');
const numeral = (index: number) => String(index).padStart(2, '0');

const rooms = [{ id: 'entrance', name: 'Entrance' }, { id: 'thread', name: 'The thread' }, { id: 'societies', name: 'The Societies Room' }, ...exhibits.map((exhibit) => ({ id: exhibit.id, name: shortTitle(exhibit.entry.data.title) })), { id: 'next-wing', name: 'The next wing' }];
---

<SiteLayout title="Ajmal Khidri — The Collection" description="Ajmal Khidri's work as a night-time museum: robotics software, hackathon builds, and two real businesses, each exhibit running in your browser.">
  <header class="topbar" data-topbar>
    <a class="mark" href="#entrance" aria-label="Back to the entrance">AK</a>
    <nav aria-label="Sections">
      <a href="#waybionic-ground-station">Collection</a>
      <a href="#thinking">Thinking</a>
      <a href="#experience">Experience</a>
      <a href="#toolbox">Toolbox</a>
      <a href="#contact">Contact</a>
    </nav>
    <button type="button" class="term-launch" data-term-open aria-keyshortcuts="Control+K"><span>Terminal</span><kbd>Ctrl K</kbd></button>
    <a class="btn btn-ghost btn-small" href={contact.resume} download>Resume</a>
  </header>

  <nav class="floorplan" aria-label="Museum floor plan">
    <p class="floorplan-count" data-floor-count aria-hidden="true">00 / {String(rooms.length - 1).padStart(2, '0')}</p>
    <ol>
      {rooms.map((room) => <li><a href={`#${room.id}`} data-floor-link><span>{room.name}</span></a></li>)}
    </ol>
  </nav>

  <main>
    <div class="museum" data-museum>
      <div class="stage" aria-hidden="true">
        <div class="plates">
          {rooms.map((room, index) => (
            <figure class="plate" data-plate hidden={index !== 0}>
              <img data-src={`/plates/${room.id}.webp`} alt="" width="1080" height="1080" decoding="async" />
            </figure>
          ))}
        </div>
        <canvas class="stage-ghost" data-stage-ghost></canvas>
        <div class="stage-live" data-stage-live><canvas class="museum-canvas" data-museum-canvas></canvas></div>
        <div class="stage-vignette"></div>
        <div class="stage-grain"></div>
        <div class="stage-progress"></div>
      </div>

      <section class="room room-entrance" id="entrance" data-room="entrance" data-term-target aria-labelledby="entrance-title">
        <div class="entrance-copy shell">
          <p class="entrance-kicker" data-rise>The Ajmal Khidri Collection. Open after hours.</p>
          <h1 id="entrance-title" class="entrance-title" tabindex="-1" data-rise>Systems<br />that move.</h1>
          <p class="entrance-lede" data-rise>Computer Science at the University of Calgary. Robotics software at WayBionic and the Schulich Space Rover Team, Junior Executive at the UCalgary Cybersecurity Club, the tech behind a Calgary HVAC company, and a power-washing business I run myself. Every exhibit here is real, and most of them still run.</p>
          <div class="entrance-actions" data-rise>
            <a class="btn btn-primary" href="#thread">Enter the collection</a>
            <a class="btn btn-ghost" href={contact.resume} download>Download resume</a>
          </div>
          <p class="entrance-hint" data-rise>Move your cursor to carry a torch through the hall. The arm on the plinth will reach for it.</p>
          <a class="entrance-cue" href="#thread" data-rise><span>Scroll to enter</span><i aria-hidden="true"></i></a>
        </div>
        <aside class="readout" aria-label="Live joint readout from the entrance arm" data-readout>
          <div class="readout-head"><span>/joint_states</span><span class="readout-state" data-ik-state>idle sweep</span></div>
          <dl class="readout-joints">
            <div><dt>base_yaw</dt><dd data-joint>0.0°</dd></div>
            <div><dt>shoulder</dt><dd data-joint>0.0°</dd></div>
            <div><dt>elbow</dt><dd data-joint>0.0°</dd></div>
            <div><dt>wrist_pitch</dt><dd data-joint>0.0°</dd></div>
          </dl>
          <p class="readout-note">Inverse kinematics solved in your browser every frame. A demo arm, not the WayBionic robot; that one is further in.</p>
        </aside>
      </section>

      <section class="room room-wall" id="thread" data-room="thread" data-wall="Compressors.|Nozzles.|Joints." data-accession="Wall text" aria-labelledby="thread-title">
        <article class="placard placard-wall">
          <p class="placard-numeral" aria-hidden="true">01</p>
          <header class="placard-head" data-reveal style="--i:0"><p class="accession">Wall text</p></header>
          <h2 id="thread-title" tabindex="-1">{words('Compressors. Nozzles. Joints.').map((word, w) => <><span class="word" style={`--w:${w}`}><span>{word}</span></span>{' '}</>)}</h2>
          <p class="placard-summary" data-reveal style="--i:2">Most student portfolios are a list of apps. This one keeps returning to machines that have to keep running while someone depends on them.</p>
          <ul class="thread-list" data-reveal style="--i:3">
            <li><strong>HVAC Express</strong> Since March 2024: the website, hosting, and lead generation for a family heating and cooling company, plus selling its service face to face.</li>
            <li><strong>Chinook Clean</strong> A power-washing business I own: pumps, nozzles, quotes, schedules, and a result the customer judges on the spot.</li>
            <li><strong>WayBionic and the Schulich Space Rover Team</strong> Since August 2026: diagnostics and ground-station software for a surgical arm, and controls for a Mars-style rover's arm.</li>
          </ul>
          <p class="placard-fine" data-reveal style="--i:4">Thirteen rooms ahead, one scroll each. Most have a kiosk you can open.</p>
        </article>
      </section>

      <section class="room" id="societies" data-room="societies" data-term-target data-wall="The Societies|Room" data-accession="Gallery II" data-plaques={JSON.stringify(societies.map(({ title, role, when }) => ({ title, role, when })))} aria-labelledby="societies-title">
        <article class="placard">
          <p class="placard-numeral" aria-hidden="true">02</p>
          <header class="placard-head" data-reveal style="--i:0"><p class="accession">Gallery II</p><span class="tag" data-status="ACTIVE">Current</span></header>
          <h2 id="societies-title" tabindex="-1">{words('The Societies Room').map((word, w) => <><span class="word" style={`--w:${w}`}><span>{word}</span></span>{' '}</>)}</h2>
          <p class="placard-summary" data-reveal style="--i:2">The teams I build with and the weekends I spent building. Each brass plaque on the wall is one of them.</p>
          <ul class="society-list" data-reveal style="--i:3">
            {societies.map((item) => (
              <li>
                <p class="society-name">{item.link ? <a href={item.link}>{item.title}</a> : item.title}</p>
                <p class="society-role">{item.role}<span>{item.when}</span></p>
              </li>
            ))}
          </ul>
          <div class="placard-actions" data-reveal style="--i:4">
            <button type="button" class="btn btn-ghost btn-small" data-dossier-open="dossier-societies">Read about each team</button>
          </div>
        </article>
        <dialog class="dossier" id="dossier-societies" aria-labelledby="dossier-societies-title">
          <button type="button" class="dossier-close" data-kiosk-close>Close</button>
          <p class="accession">Gallery II</p>
          <h3 id="dossier-societies-title">The Societies Room</h3>
          <ul class="dossier-societies">
            {societies.map((item) => (
              <li>
                <p class="society-when">{item.when}</p>
                <p class="society-name">{item.title}<span>{item.role}</span></p>
                <p class="society-detail">{item.detail}</p>
              </li>
            ))}
          </ul>
          <h4>Earlier volunteering</h4>
          <ul class="dossier-societies">{pastSocieties.map((item) => <li><p class="society-when">{item.when}</p><p class="society-name">{item.title}<span>{item.role}</span></p></li>)}</ul>
        </dialog>
      </section>

      {exhibits.map((exhibit, order) => {
        const data = exhibit.entry.data;
        const used = skillsFor(exhibit.id);
        const title = data.title;
        const [main, subtitle] = title.split(' — ');
        return (
          <section
            class="room"
            id={exhibit.id}
            data-room={exhibit.id}
            data-term-target
            data-sculpture={exhibit.sculpture}
            data-paintings={JSON.stringify((exhibit.paintings ?? []).map((painting) => ({ src: painting.src })))}
            data-wall={exhibit.wall}
            data-accession={exhibit.accession}
            aria-labelledby={`${exhibit.id}-title`}
          >
            <article class="placard" data-case={exhibit.id}>
              <p class="placard-numeral" aria-hidden="true">{numeral(order + 3)}</p>
              <header class="placard-head" data-reveal style="--i:0">
                <p class="accession">{exhibit.accession}</p>
                <span class="tag" data-status={data.status}>{statusWord[data.status]}</span>
              </header>
              <h2 id={`${exhibit.id}-title`} tabindex="-1" data-case-title>{words(main).map((word, w) => <><span class="word" style={`--w:${w}`}><span>{word}</span></span>{' '}</>)}{subtitle ? <><span class="sr-only"> — </span><span class="placard-sub" data-reveal style="--i:1">{subtitle}</span></> : null}</h2>
              <p class="placard-meta" data-reveal style="--i:2">{data.year}, {data.role}</p>
              <p class="placard-summary" data-reveal style="--i:3">{data.summary}</p>
              {data.contribution ? <p class="placard-part" data-reveal style="--i:4"><strong>My part.</strong> {data.contribution}</p> : null}

              {exhibit.control === 'arm' ? (
                <fieldset class="controls" data-reveal style="--i:5" data-arm-controls>
                  <legend>Take the controls of the real arm model</legend>
                  <div class="joint-grid">
                    {armJoints.map((joint) => (
                      <label class="joint-slider">
                        <span>{joint.label}<b data-joint-value>{Math.round((joint.value * 180) / Math.PI)}°</b></span>
                        <input type="range" min={joint.min} max={joint.max} step="0.01" value={joint.value} data-arm-joint={joint.name} />
                      </label>
                    ))}
                  </div>
                  <p class="controls-note">Limits come from the team's URDF. The motion test resumes nine seconds after you let go.</p>
                </fieldset>
              ) : null}
              {exhibit.control === 'sun' ? (
                <fieldset class="controls" data-reveal style="--i:5">
                  <legend>Move the sun around the south pole</legend>
                  <label class="joint-slider"><span>Sun azimuth <b data-sun-value>auto</b></span><input type="range" min="0" max="6.283" step="0.01" value="0" data-sun /></label>
                  <p class="controls-note">The light stays low on the horizon, so crater rims throw long shadows. That trade-off is what SouthPoint maps.</p>
                </fieldset>
              ) : null}
              {exhibit.control === 'wash' ? (
                <fieldset class="controls" data-reveal style="--i:5">
                  <legend>Take the wand</legend>
                  <div class="control-row">
                    <button type="button" class="hold" data-wash-hold aria-describedby={`${exhibit.id}-wash-note`}>Hold to spray</button>
                    <button type="button" data-wash-reset>Reset the slab</button>
                  </div>
                  <p class="controls-note" id={`${exhibit.id}-wash-note`}>Hold the button (or Space) and watch the grime come off the pavers. No customer photos here: those need the customer's permission.</p>
                </fieldset>
              ) : null}
              {exhibit.control === 'tamper' ? (
                <fieldset class="controls" data-reveal style="--i:5">
                  <legend>Test the chain</legend>
                  <div class="control-row"><button type="button" data-tamper>Tamper with record 4</button></div>
                  <p class="controls-note">Watch the chain: the edited record turns amber, then every block after it fails verification.</p>
                </fieldset>
              ) : null}

              <div class="placard-actions" data-reveal style="--i:6">
                {exhibit.kiosk ? <button type="button" class="btn btn-primary btn-small" data-kiosk-open={`kiosk-${exhibit.kiosk}`}>Try it: {exhibit.kioskTitle}</button> : null}
                <button type="button" class="btn btn-ghost btn-small" data-dossier-open={`dossier-${exhibit.id}`}>Exhibit notes</button>
                {exhibit.paintings?.length ? <button type="button" class="text-button" data-curtain={exhibit.id} aria-pressed="false">Draw the curtains</button> : null}
                {data.link ? <a class="placard-link" href={data.link} target="_blank" rel="noreferrer">{sentence(data.linkLabel ?? 'View project')}</a> : null}
              </div>
            </article>

            <dialog class="dossier" id={`dossier-${exhibit.id}`} aria-labelledby={`dossier-${exhibit.id}-title`}>
              <button type="button" class="dossier-close" data-kiosk-close>Close</button>
              <p class="accession">{exhibit.accession}</p>
              <h3 id={`dossier-${exhibit.id}-title`}>{shortTitle(title)}</h3>
              <p class="placard-meta">{data.year}, {data.role}</p>
              {data.contribution ? <p class="dossier-part"><strong>My part.</strong> {data.contribution}</p> : null}

              {exhibit.paintings?.length ? (
                <div class="thumbs">
                  {exhibit.paintings.map((painting) => (
                    <button type="button" class="thumb" data-lightbox={painting.src} data-caption={painting.caption}>
                      <img src={painting.src.replace('.webp', '-640.webp')} alt={painting.alt} width="640" height="400" loading="lazy" decoding="async" />
                      <span>{painting.caption}</span>
                    </button>
                  ))}
                </div>
              ) : null}

              <dl class="dossier-notes">
                {data.problem ? <div><dt>Problem</dt><dd>{data.problem}</dd></div> : null}
                {data.system ? <div><dt>{data.status === 'SHIPPED' || data.status === 'ACTIVE' ? 'System' : 'Current design'}</dt><dd>{data.system}</dd></div> : null}
                {data.decision ? <div><dt>Key decision</dt><dd>{data.decision}</dd></div> : null}
                {data.highlights?.length ? <div><dt>Built</dt><dd><ul>{data.highlights.map((item) => <li>{item}</li>)}</ul></dd></div> : null}
                {data.lesson ? <div><dt>What broke, what I learned</dt><dd>{data.lesson}</dd></div> : null}
                {data.team ? <div><dt>Team</dt><dd>{data.team}</dd></div> : null}
                {data.next ? <div><dt>Next</dt><dd>{data.next}</dd></div> : null}
                <div><dt>Stack</dt><dd><ul class="stack">{stackList(data.stack).map((item) => <li>{item}</li>)}</ul></dd></div>
              </dl>

              {used.length ? (
                <div class="skills-on-show">
                  <p>Skills on show</p>
                  <ul>{used.map((skill) => <li><a href="#toolbox" data-dossier-leave>{skill.name}</a></li>)}</ul>
                </div>
              ) : null}
            </dialog>
          </section>
        );
      })}

      <section class="room room-finale" id="next-wing" data-room="next-wing" data-sculpture="barrier" data-accession="AK.next" aria-labelledby="next-wing-title">
        <article class="placard">
          <p class="placard-numeral" aria-hidden="true">{numeral(rooms.length - 1)}</p>
          <header class="placard-head" data-reveal style="--i:0"><p class="accession">Under construction</p><span class="tag" data-status="IN PROGRESS">In progress</span></header>
          <h2 id="next-wing-title" tabindex="-1">{words('The next wing').map((word, w) => <><span class="word" style={`--w:${w}`}><span>{word}</span></span>{' '}</>)}</h2>
          <p class="placard-summary" data-reveal style="--i:2">The goal is a robotics company that ships machines into the real world. The next exhibits are being built in simulation first, so none of them waits on buying hardware.</p>
          <ol class="mini-route" data-reveal style="--i:3">
            {roadmap.map((stop) => <li data-state={stop.state}><strong>{stop.tool}</strong><span>{stop.skill}</span></li>)}
          </ol>
          <div class="placard-actions" data-reveal style="--i:4"><a class="btn btn-primary btn-small" href="#thinking">Leave the hall for the archive</a></div>
        </article>
      </section>
    </div>

    <div class="archive">
    <section class="thinking night" id="thinking" data-term-target aria-labelledby="thinking-title">
      <div class="shell">
        <div>
          <h2 id="thinking-title" class="section-title">How I make a call</h2>
          <p class="section-intro">One real decision from WayBionic, annotated. The arm is surgical hardware; the ground station is the first place a mistake would show up.</p>
        </div>
        <div class="decision">
          <pre class="decision-code" aria-label="Illustrative ground-station launch parameters"><code>{decisionLines.map((line, index) => (
            <span class="line" data-note={line.note}><span class="ln">{index + 1}</span><Fragment set:html={line.html} />{line.pin ? <i class="pin" aria-hidden="true">{line.note}</i> : null}</span>
          ))}</code></pre>
          <ol class="decision-notes">
            <li tabindex="0" data-note="1"><strong>Simulation is the default.</strong> Motion tests publish to a simulated joint-state driver. Touching the real arm is a deliberate opt-in, not the path you fall into.</li>
            <li tabindex="0" data-note="2"><strong>The monitor watches; it never drives.</strong> A read-only diagnostics panel means a UI bug can mislead an operator but cannot move a joint.</li>
            <li tabindex="0" data-note="3"><strong>Old data must look old.</strong> Code review on my diagnostics CLI caught old samples shown as fresh. A stale value that looks current is worse than no value, so stale and future-dated samples are flagged.</li>
            <li tabindex="0" data-note="4"><strong>One sensor can't hide another's fault.</strong> Review also caught a fault vanishing when a different sensor updated. Status is now merged per publisher, and each fix has a regression test: 11 passing on ROS 2 Jazzy.</li>
          </ol>
        </div>
        <p class="fine">The config block paraphrases the decisions for reading; it is not copied from the team repository.</p>
      </div>
    </section>

    <section class="experience paper" id="experience" data-term-target aria-labelledby="experience-title">
      <div class="shell">
        <h2 id="experience-title" class="section-title">Experience</h2>
        <div class="exp-grid">
          <ol class="timeline">
            {roles.map((role) => (
              <li data-kind={role.kind}>
                <p class="when">{role.start === 'Ongoing' ? 'Ongoing' : `${role.start} to ${role.end}`}</p>
                <h3>{role.title}</h3>
                <p class="org">{role.org}</p>
                <ul>{role.points.map((point) => <li>{point}</li>)}</ul>
              </li>
            ))}
          </ol>
          <aside class="exp-side">
            <div class="exp-block">
              <h3>Education</h3>
              {education.map((item) => (
                <div class="edu">
                  <p class="edu-school">{item.school}</p>
                  <p>{item.credential}</p>
                  <p class="when">{item.when}</p>
                  <ul>{item.notes.map((note) => <li>{note}</li>)}</ul>
                </div>
              ))}
            </div>
            <div class="exp-block">
              <h3>Awards</h3>
              <ul class="plain">{awards.map((award) => <li><strong>{award.name}</strong><span>{award.detail}</span></li>)}</ul>
            </div>
            <div class="exp-block">
              <h3>Certifications</h3>
              <ul class="plain">{certifications.map((cert) => <li><strong>{cert.name}</strong><span>{cert.issuer}, {cert.when}</span></li>)}</ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="toolbox paper-deep" id="toolbox" data-term-target aria-labelledby="toolbox-title">
      <div class="shell">
        <div>
          <h2 id="toolbox-title" class="section-title">Toolbox</h2>
          <p class="section-intro">No skill bars. Each tool links to the exhibits where it was actually used, so you can walk back and check. Hatched entries are on the roadmap and still being learned.</p>
        </div>
        <div class="skill-groups">
          {skillGroups.map(({ group, items }) => (
            <div class="skill-group">
              <h3>{group}</h3>
              <ul>
                {items.map((skill) => (
                  <li class:list={['skill', { learning: skill.learning }]}>
                    <span class="skill-name">{skill.name}</span>
                    <span class="skill-used">
                      {skill.used.map((id) => onTour.has(id) ? <a href={`#${id}`}>{projectNames[id] ?? id}</a> : <span>{projectNames[id] ?? id}</span>)}
                    </span>
