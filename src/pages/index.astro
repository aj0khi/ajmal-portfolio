  <dialog class="kiosk" id="kiosk-hvac" aria-label="Comfort, calculated"><button type="button" class="kiosk-close" data-kiosk-close>Close</button><div class="instrument-wrap"><HvacSimulator /></div></dialog>
  <dialog class="lightbox" data-lightbox-dialog aria-label="Exhibit image"><button type="button" class="kiosk-close" data-kiosk-close>Close</button><img alt="" data-lightbox-img /><p data-lightbox-caption></p></dialog>

  <SiteTerminal />
</SiteLayout>

<script>
  import { startTour } from '../scripts/museum/tour';
  import { startPlates } from '../scripts/museum/plates';

  const museum = document.querySelector<HTMLElement>('[data-museum]');
  const send = (room: string, key: string, value: number) => dispatchEvent(new CustomEvent('museum:control', { detail: { room, key, value } }));

  // Everyone starts on the pocket guide's photographs, so the first paint is never an empty
  // black stage. Wide landscape screens with WebGL then load the live hall (and Three.js) on
  // top; phones, portrait tablets, and anything that fails stay on the photographs.
  if (museum) {
    const tour = startTour(museum);
    const stopPlates = startPlates(museum, tour);
    const probe = document.createElement('canvas');
    const webgl = Boolean(probe.getContext('webgl2') ?? probe.getContext('webgl'));
    const roomy = matchMedia('(min-width: 900px) and (orientation: landscape)').matches;
    if (webgl && roomy) {
      import('../scripts/museum/museum')
        .then(({ startMuseum }) => startMuseum(museum, tour))
        .then(() => { stopPlates(); museum.classList.add('is-3d'); })
        .catch(() => museum.classList.add('is-plates'));
    } else museum.classList.add('is-plates');
  }

  const floorplan = document.querySelector<HTMLElement>('.floorplan');
  if (museum && floorplan) new IntersectionObserver(([entry]) => floorplan.classList.toggle('is-hidden', !entry.isIntersecting), { rootMargin: '-40% 0px -40% 0px' }).observe(museum);

  // The bar stays clear over the hall and turns solid once the archive scrolls under it.
  const topbar = document.querySelector<HTMLElement>('[data-topbar]');
  const archive = document.querySelector<HTMLElement>('.archive');
  const syncBar = () => topbar?.classList.toggle('is-solid', Boolean(archive && archive.getBoundingClientRect().top < 80));
  addEventListener('scroll', syncBar, { passive: true });
  syncBar();

  // Reading a note lights the config lines it explains; pointing at a line finds its note.
  // Mouse follows hover, touch toggles on tap, and the keyboard follows focus.
  const decision = document.querySelector<HTMLElement>('.decision');
  if (decision) {
    const notes = [...decision.querySelectorAll<HTMLElement>('.decision-notes [data-note]')];
    const noteAt = (target: EventTarget | null) => (target as HTMLElement | null)?.closest<HTMLElement>('[data-note]')?.dataset.note;
    const show = (note?: string) => {
      if (note) decision.dataset.active = note;
      else delete decision.dataset.active;
      notes.forEach((item) => item.classList.toggle('is-active', item.dataset.note === note));
    };
    let pointer = 'mouse';
    decision.addEventListener('pointerdown', (event) => { pointer = event.pointerType; });
    decision.addEventListener('pointerover', (event) => {
      if (event.pointerType !== 'mouse') return;
      const note = noteAt(event.target);
      if (note) show(note);
      else if ((event.target as HTMLElement).closest('.line')) show();
    });
    decision.addEventListener('pointerleave', (event) => { if (event.pointerType === 'mouse') show(); });
    decision.addEventListener('click', (event) => {
      if (pointer === 'mouse') return;
      const note = noteAt(event.target);
      show(note && note !== decision.dataset.active ? note : undefined);
    });
    // Only keyboard focus counts here: a tap also focuses the note, and its click does the toggling.
    decision.addEventListener('focusin', (event) => { if ((event.target as HTMLElement).matches(':focus-visible')) show(noteAt(event.target)); });
    decision.addEventListener('focusout', (event) => { if (!decision.contains(event.relatedTarget as Node | null)) show(); });
  }

  // Arm controls drive the real URDF model in the hall.
  document.querySelectorAll<HTMLInputElement>('[data-arm-joint]').forEach((input) => {
    input.addEventListener('input', () => {
      send('waybionic-ground-station', input.dataset.armJoint ?? '', Number(input.value));
      const label = input.closest('label')?.querySelector('[data-joint-value]');
      if (label) label.textContent = `${Math.round((Number(input.value) * 180) / Math.PI)}°`;
    });
  });
  const sun = document.querySelector<HTMLInputElement>('[data-sun]');
  sun?.addEventListener('input', () => {
    send('southpoint', 'sun', Number(sun.value));
    const label = document.querySelector('[data-sun-value]');
    if (label) label.textContent = `${Math.round((Number(sun.value) * 180) / Math.PI)}°`;
  });
  document.querySelector('[data-tamper]')?.addEventListener('click', () => send('physical-ai-blackbox', 'tamper', 1));
  document.querySelector('[data-chain-mutate]')?.addEventListener('click', () => send('physical-ai-blackbox', 'tamper', 1));

  const hold = document.querySelector<HTMLButtonElement>('[data-wash-hold]');
  if (hold) {
    const on = () => { send('chinook-clean', 'spray', 1); hold.classList.add('is-held'); };
    const off = () => { send('chinook-clean', 'spray', 0); hold.classList.remove('is-held'); };
    hold.addEventListener('pointerdown', (event) => { hold.setPointerCapture(event.pointerId); on(); });
    hold.addEventListener('pointerup', off);
    hold.addEventListener('pointercancel', off);
    hold.addEventListener('keydown', (event) => { if ((event.key === ' ' || event.key === 'Enter') && !event.repeat) { event.preventDefault(); on(); } });
    hold.addEventListener('keyup', (event) => { if (event.key === ' ' || event.key === 'Enter') off(); });
    hold.addEventListener('blur', off);
  }
  document.querySelector('[data-wash-reset]')?.addEventListener('click', () => send('chinook-clean', 'reset', 1));

  document.querySelectorAll<HTMLButtonElement>('[data-curtain]').forEach((button) => {
    button.addEventListener('click', () => {
      const closed = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(closed));
      button.textContent = closed ? 'Open the curtains' : 'Draw the curtains';
      send(button.dataset.curtain ?? '', 'curtain', closed ? 0 : 1);
    });
  });

  // Kiosks, dossiers and the lightbox are native modal dialogs: focus is trapped and Escape
  // closes them. Closing plays a short exit first, so a dossier slides back where it came from.
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const pendingExit = new WeakMap<HTMLDialogElement, () => void>();
  const settle = (dialog: HTMLDialogElement) => {
    pendingExit.get(dialog)?.();
    dialog.classList.remove('is-closing');
  };
  const finish = (dialog: HTMLDialogElement) => { settle(dialog); if (dialog.open) dialog.close(); };
  const dismiss = (dialog: HTMLDialogElement) => {
    // A second close request mid-exit (double click, repeated Escape) just finishes it.
    if (reducedMotion.matches || dialog.classList.contains('is-closing')) { finish(dialog); return; }
    dialog.classList.add('is-closing');
    // Only the dialog's own exit counts; animations ending inside it bubble up too.
    const onEnd = (event: AnimationEvent) => { if (event.target === dialog) finish(dialog); };
    const timer = window.setTimeout(() => finish(dialog), 400);
    dialog.addEventListener('animationend', onEnd);
    pendingExit.set(dialog, () => { clearTimeout(timer); dialog.removeEventListener('animationend', onEnd); pendingExit.delete(dialog); });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-kiosk-open], [data-dossier-open]').forEach((button) => {
    const id = button.dataset.kioskOpen ?? button.dataset.dossierOpen;
    button.addEventListener('click', () => document.querySelector<HTMLDialogElement>(`#${id}`)?.showModal());
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.kiosk, dialog.lightbox, dialog.dossier').forEach((dialog) => {
    dialog.querySelector('[data-kiosk-close]')?.addEventListener('click', () => dismiss(dialog));
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dismiss(dialog); });
    dialog.addEventListener('cancel', (event) => { event.preventDefault(); dismiss(dialog); });
    dialog.addEventListener('close', () => settle(dialog));
  });
  // A skill link inside a dossier leaves the hall for the toolbox, so close the drawer first.
  document.querySelectorAll<HTMLAnchorElement>('[data-dossier-leave]').forEach((link) => {
    link.addEventListener('click', () => link.closest('dialog')?.close());
  });
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((button) => {
    button.addEventListener('click', () => {
      const image = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-img]');
      const caption = lightbox?.querySelector<HTMLElement>('[data-lightbox-caption]');
      if (image) { image.src = button.dataset.lightbox ?? ''; image.alt = button.querySelector('img')?.alt ?? ''; }
      if (caption) caption.textContent = button.dataset.caption ?? '';
      lightbox?.showModal();
    });
  });
</script>
