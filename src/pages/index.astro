---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DesktopWindow from '../components/DesktopWindow.astro';
import OsIcon from '../components/OsIcon.astro';
import WayBionicDiagram from '../components/WayBionicDiagram.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="AjmalOS — Ajmal Khidri">
  <main class="crt-monitor">
    <div class="monitor-bezel">
      <div class="monitor-brand">AJMAL<span>OS</span></div>
      <div class="crt-screen" data-desktop>
        <div class="crt-glow" aria-hidden="true"></div>
        <div class="desktop-wallpaper">
          <div class="sky-noise" aria-hidden="true"></div>
          <div class="hill hill-back" aria-hidden="true"></div>
          <div class="hill hill-front" aria-hidden="true"></div>
          <div class="desktop-status mono">AJMALOS 1.0 / LOCAL ARCHIVE / {new Date().getFullYear()}</div>

          <div class="desktop-icons" aria-label="Applications">
            <OsIcon window="portfolio" icon="▣" label="My Work" />
            <OsIcon window="waybionic" icon="⚙" label="WayBionic" />
            <OsIcon window="blackbox" icon="⬢" label="BlackBox" />
            <OsIcon window="rover" icon="▤" label="Rover" />
            <OsIcon window="resume" icon="▧" label="Resume" />
            <OsIcon window="about" icon="★" label="About Aj" />
            <OsIcon window="browser" icon="⌕" label="Browser" />
            <OsIcon window="calculator" icon="⊞" label="Calculator" />
            <OsIcon window="recycle" icon="♻" label="Recycle Bin" />
            <OsIcon window="games" icon="✣" label="Games" />
          </div>

          <DesktopWindow id="portfolio" title="MY WORK / FILE EXPLORER" icon="▣" open class="window-portfolio">
            <div class="file-toolbar mono">FILE &nbsp; EDIT &nbsp; VIEW &nbsp; HELP <span>LOCAL ARCHIVE / 04 ITEMS</span></div>
            <div class="explorer-heading">
              <p class="window-kicker mono">AJMAL KHIDRI / WORKING SYSTEMS</p>
              <h1>Things I have<br /><em>built or touched.</em></h1>
              <p class="window-intro">A personal archive of physical systems, software, and the businesses that taught me to keep things running.</p>
            </div>
            <div class="project-grid">
              {projects.map((project, projectIndex) => (
                <article class="file-card">
                  <div class="file-card-top mono"><span>{String(projectIndex + 1).padStart(2, '0')}</span><span>{project.data.status}</span></div>
                  <h2>{project.data.title}</h2>
                  <p>{project.data.summary}</p>
                  <div class="file-tags mono">{project.data.stack}</div>
                  {project.data.link ? <a href={project.data.link} target="_blank" rel="noreferrer">OPEN SOURCE ↗</a> : null}
                </article>
              ))}
            </div>
          </DesktopWindow>

          <DesktopWindow id="waybionic" title="WAYBIONIC / ENGINEERING MONITOR" icon="⚙" class="window-waybionic">
            <div class="window-kicker mono">UCalgary CLUB / ROS2 GROUND STATION / ACTIVE</div>
            <h2>I built the movement panels<br /><em>and the errors they surface.</em></h2>
            <p class="window-copy">The monitor checks joint and system state, then reflects stale values and errors inside RViz instead of hiding uncertainty. Motion tests stay controlled until the real arm is ready.</p>
            <div class="waybionic-proof-grid">
              <figure><img src="/assets/waybionic/engineer-monitor-normal.png" alt="WayBionic Engineering Monitor in a mock normal state." loading="lazy" /><figcaption class="mono">MOCK NORMAL / RVIZ</figcaption></figure>
              <figure><img src="/assets/waybionic/engineer-monitor-fault.png" alt="WayBionic Engineering Monitor showing a mock fault state." loading="lazy" /><figcaption class="mono">MOCK FAULT / STALE STATE</figcaption></figure>
            </div>
            <div class="joint-panel"><WayBionicDiagram /></div>
            <div class="window-actions"><a href="https://github.com/Waybionic/waybionic_ground_station" target="_blank" rel="noreferrer">OPEN REPOSITORY ↗</a><a href="https://drive.google.com/file/d/1WWgNoo82JjGdWspCLcINrK6-YqnF9omR/view?usp=sharing" target="_blank" rel="noreferrer">ARM VIDEO ↗</a></div>
          </DesktopWindow>

          <DesktopWindow id="blackbox" title="BLACKBOX / PROJECT NOTES" icon="⬢" class="window-blackbox">
            <div class="window-kicker mono">PHYSICAL AI / VERSION 3 DRAFT / SEPTEMBER 2026</div>
            <h2>A local-first evidence stack<br /><em>for physical AI systems.</em></h2>
            <p class="window-copy">BlackBox is a tamper-evident recorder concept and working Python project for capturing what an AI system was told, what it commanded, and what physically happened.</p>
            <div class="blackbox-layers">
              <div><strong>01</strong><span>Evidence core</span><small>Canonical records, hash chains, sealing, signatures, validation.</small></div>
              <div><strong>02</strong><span>Owner portal</span><small>Device-bound local monitoring, protected uploads, hidden evidence storage.</small></div>
              <div><strong>03</strong><span>Investigator workbench</span><small>Offline bundle review, case summaries, evidence export.</small></div>
              <div><strong>04</strong><span>Ledger + verifier</span><small>Witness tree heads, sealed release packets, local verification flow.</small></div>
            </div>
            <div class="window-note mono">PUBLIC VIEW / HIGH-LEVEL ARCHITECTURE ONLY / SENSITIVE DETAILS OMITTED</div>
          </DesktopWindow>

          <DesktopWindow id="rover" title="ROVER / CS30 CAPSTONE" icon="▤" class="window-rover">
            <div class="window-kicker mono">JAVA / PHIDGETS SDK / HARDWARE CONTROL</div>
            <h2>Teaching software<br /><em>to notice obstacles.</em></h2>
            <p class="window-copy">A wireless rover with independent left/right DC motor control and sonar-based distance sensing. The code separates movement, sensing, acceleration, and challenge logic.</p>
            <div class="rover-diagram" aria-label="Rover control flow"><span>SONAR</span><b>→</b><span>DECISION</span><b>→</b><span>MOTOR CONTROL</span></div>
            <div class="window-actions"><a href="https://github.com/aj0khi/CS30/tree/main/RoverProejct" target="_blank" rel="noreferrer">OPEN ROVER SOURCE ↗</a></div>
          </DesktopWindow>

          <DesktopWindow id="resume" title="RESUME / AJMAL KHIDRI" icon="▧" class="window-resume">
            <div class="window-kicker mono">CURRENT DOCUMENT / SOFTWARE INTERNSHIP</div>
            <h2>Computer Science student<br /><em>building systems that move.</em></h2>
            <div class="resume-facts"><span>CALGARY, AB / 587-583-7530</span><span>UCalgary / B.Sc. Computer Science / EXPECTED 2029</span><span>TRANSFERRED FROM MOUNT ROYAL UNIVERSITY</span><span>JAVA / PYTHON / JAVASCRIPT / HTML + CSS</span><span>OOP / DATA STRUCTURES / FILE I/O / HARDWARE INTEGRATION</span><span>HVAC EXPRESS / TECHNICAL LEAD + SALES</span><span>WAYBIONIC ROBOTICS / ROS2 SURGICAL ARM</span></div>
            <p class="resume-small">Dean's List · $10,000+ in scholarships and grants · Gauss Mathematics Contest Excellence Award · Community Service Recognition Award</p>
            <a class="resume-download" href="/resume/Ajmal_Khidri_Software_Internship.docx" download>DOWNLOAD RESUME / DOCX ↘</a>
          </DesktopWindow>

          <DesktopWindow id="about" title="ABOUT AJ / PERSONAL" icon="★" class="window-about">
            <div class="window-kicker mono">OUTSIDE THE CODE</div>
            <h2>The person behind<br /><em>the systems.</em></h2>
            <p class="window-copy">When I am not building or debugging, I am usually somewhere between a Star Wars Legends rabbit hole, a very fast car, a competitive match, and a Banff trail.</p>
            <div class="fun-facts"><span>✦ Star Wars / Legends + canon</span><span>✦ Cars that are extremely fast and cool</span><span>✦ Valorant / Geometry Dash / Brawl Stars</span><span>✦ Banff trails / Johnston Canyon / Big Beehive / Sarail Ridge</span></div>
          </DesktopWindow>

          <DesktopWindow id="games" title="GAMES / PERSONAL" icon="✣" class="window-games">
            <div class="window-kicker mono">AFTER HOURS / PERSONAL ARCHIVE</div>
            <h2>Different systems,<br /><em>same obsession.</em></h2>
            <div class="games-list"><div><strong>VALORANT</strong><span>Rounds, reads, and clean utility.</span></div><div><strong>GEOMETRY DASH</strong><span>Timing, repetition, and stubbornness.</span></div><div><strong>BRAWL STARS</strong><span>Fast matches and chaotic decisions.</span></div><div><strong>BANFF TRAILS</strong><span>Johnston Canyon / Big Beehive / Sarail Ridge.</span></div></div>
          </DesktopWindow>

          <DesktopWindow id="recycle" title="RECYCLE BIN" icon="♻" class="window-recycle">
            <div class="window-kicker mono">SYSTEM UTILITY</div>
            <h2>Nothing deleted<br /><em>yet.</em></h2>
            <p class="window-copy">This bin is intentionally empty. Old ideas are usually archived, rebuilt, or turned into the next useful thing.</p>
            <div class="empty-bin mono">0 OBJECTS / 0 BYTES</div>
          </DesktopWindow>

          <DesktopWindow id="calculator" title="CALCULATOR" icon="⊞" class="window-calculator">
            <div class="calculator-display" data-calculator-display>0</div>
            <div class="calculator-keys">
              {['7', '8', '9', '/', '4', '5', '6', '*', '1', '2', '3', '-', '0', '.', '=', '+', 'C'].map((key) => <button type="button" data-calculator-key={key}>{key}</button>)}
            </div>
          </DesktopWindow>

          <DesktopWindow id="browser" title="AJMAL BROWSER" icon="⌕" class="window-browser">
            <div class="browser-toolbar">
              <button type="button" data-browser-back aria-label="Back">◀</button><button type="button" data-browser-forward aria-label="Forward">▶</button><button type="button" data-browser-refresh aria-label="Refresh">↻</button>
              <form data-browser-form><input data-browser-input value="https://github.com/aj0khi" aria-label="Browser address" /><button type="submit">GO</button></form>
            </div>
            <div class="browser-home" data-browser-home><p class="window-kicker mono">AJMAL BROWSER / QUICK LINKS</p><h2>Open a useful<br /><em>window to the web.</em></h2><div class="browser-links"><button type="button" data-browser-link="https://github.com/aj0khi">GitHub / aj0khi</button><button type="button" data-browser-link="https://calgaryhvacexpress.ca/">HVAC Express</button><button type="button" data-browser-link="https://www.linkedin.com/in/ajmal-khidri/">LinkedIn</button></div><p class="window-note mono">Some external sites block embedded viewing. Use the address bar or open the link in a new tab.</p></div>
            <iframe data-browser-frame title="Embedded browser" sandbox="allow-forms allow-modals allow-popups allow-presentation allow-scripts" hidden></iframe>
          </DesktopWindow>

          <div class="start-menu" data-start-menu hidden>
            <div class="start-heading"><strong>AJMAL</strong><span>OS</span></div>
            <button type="button" data-window-open="portfolio">▣ &nbsp; My Work</button>
            <button type="button" data-window-open="resume">▧ &nbsp; Resume</button>
            <button type="button" data-window-open="about">★ &nbsp; About Aj</button>
            <a href="mailto:khidri.ajmal@gmail.com">✉ &nbsp; Email Ajmal</a>
          </div>

          <footer class="taskbar">
            <button class="start-button" type="button" data-start-toggle>START</button>
            <div class="taskbar-windows" data-taskbar></div>
            <div class="system-tray mono">▣ <span data-clock>00:00</span></div>
          </footer>
        </div>
      </div>
      <div class="monitor-led" aria-label="Monitor status"><span></span> POWER / ONLINE</div>
    </div>
  </main>
</BaseLayout>

<script>
  const desktop = document.querySelector('[data-desktop]');
  const taskbar = document.querySelector('[data-taskbar]');
  const startMenu = document.querySelector<HTMLElement>('[data-start-menu]');
  const startToggle = document.querySelector('[data-start-toggle]');
  let highestZ = 10;

  if (desktop && taskbar && startMenu && startToggle) {
    const windows = desktop.querySelectorAll<HTMLElement>('[data-window]');
    const focusWindow = (id: string) => {
      const target = desktop.querySelector<HTMLElement>(`[data-window="${id}"]`);
      if (!target) return;
      target.hidden = false;
      target.dataset.windowOpened = 'true';
      target.dataset.windowMinimized = 'false';
      highestZ += 1;
      target.style.zIndex = String(highestZ);
      desktop.querySelectorAll(`[data-task-window="${id}"]`).forEach((item) => item.classList.add('active'));
      desktop.querySelectorAll('[data-task-window]').forEach((item) => {
        if (item.getAttribute('data-task-window') !== id) item.classList.remove('active');
      });
    };

    const toggleMaximize = (windowElement: HTMLElement) => {
      windowElement.classList.toggle('is-maximized');
      windowElement.dataset.maximized = windowElement.classList.contains('is-maximized') ? 'true' : 'false';
    };

    windows.forEach((windowElement) => {
      if (!windowElement.hidden) windowElement.dataset.windowOpened = 'true';
      const titlebar = windowElement.querySelector<HTMLElement>('.window-titlebar');
      if (!titlebar) return;

      titlebar.addEventListener('pointerdown', (event) => {
        if ((event.target as HTMLElement).closest('button')) return;
        focusWindow(windowElement.dataset.window ?? '');
        const desktopBounds = desktop.getBoundingClientRect();
        const windowBounds = windowElement.getBoundingClientRect();
        const offsetX = event.clientX - windowBounds.left;
        const offsetY = event.clientY - windowBounds.top;

        const moveWindow = (moveEvent: PointerEvent) => {
          const nextLeft = Math.max(0, Math.min(desktopBounds.width - windowBounds.width, moveEvent.clientX - desktopBounds.left - offsetX));
          const nextTop = Math.max(0, Math.min(desktopBounds.height - windowBounds.height - 32, moveEvent.clientY - desktopBounds.top - offsetY));
          windowElement.style.left = `${nextLeft}px`;
          windowElement.style.top = `${nextTop}px`;
        };

        const releaseWindow = () => {
          window.removeEventListener('pointermove', moveWindow);
          window.removeEventListener('pointerup', releaseWindow);
        };

        window.addEventListener('pointermove', moveWindow);
        window.addEventListener('pointerup', releaseWindow, { once: true });
      });

      titlebar.addEventListener('dblclick', (event) => {
        if ((event.target as HTMLElement).closest('button')) return;
        toggleMaximize(windowElement);
      });
    });

    const rebuildTaskbar = () => {
      taskbar.innerHTML = '';
      windows.forEach((item) => {
        if (item.dataset.windowOpened === 'true') {
          const button = document.createElement('button');
          button.type = 'button';
          button.dataset.taskWindow = item.dataset.window ?? '';
          button.textContent = item.querySelector('.window-title')?.textContent?.trim() ?? 'Window';
          if (item.hidden) button.classList.add('minimized');
          button.addEventListener('click', () => focusWindow(item.dataset.window ?? ''));
          taskbar.append(button);
        }
      });
    };

    desktop.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const opener = target.closest<HTMLElement>('[data-window-open]');
      const closer = target.closest<HTMLElement>('[data-window-close]');
      const minimizer = target.closest<HTMLElement>('[data-window-minimize]');
      const maximizer = target.closest<HTMLElement>('[data-window-maximize]');

      if (opener) {
        focusWindow(opener.dataset.windowOpen ?? '');
        startMenu.hidden = true;
        rebuildTaskbar();
      }
      if (closer) {
        const id = closer.dataset.windowClose ?? '';
        const targetWindow = desktop.querySelector<HTMLElement>(`[data-window="${id}"]`);
        if (targetWindow) {
          targetWindow.hidden = true;
          targetWindow.dataset.windowOpened = 'false';
          targetWindow.dataset.windowMinimized = 'false';
        }
        rebuildTaskbar();
      }
      if (minimizer) {
        const id = minimizer.dataset.windowMinimize ?? '';
        const targetWindow = desktop.querySelector<HTMLElement>(`[data-window="${id}"]`);
        if (targetWindow) {
          targetWindow.hidden = true;
          targetWindow.dataset.windowMinimized = 'true';
        }
        rebuildTaskbar();
      }
      if (maximizer) {
        const id = maximizer.dataset.windowMaximize ?? '';
        const targetWindow = desktop.querySelector<HTMLElement>(`[data-window="${id}"]`);
        if (targetWindow) toggleMaximize(targetWindow);
      }
    });

    startToggle.addEventListener('click', () => {
      startMenu.hidden = !startMenu.hidden;
    });
    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (!startMenu.contains(target) && target !== startToggle) startMenu.hidden = true;
    });

    const clock = desktop.querySelector('[data-clock]');
    const updateClock = () => {
      if (clock) clock.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    };
    updateClock();
    window.setInterval(updateClock, 30000);
    rebuildTaskbar();

    const calculatorDisplay = desktop.querySelector<HTMLElement>('[data-calculator-display]');
    let calculatorValue = '';
    let calculatorExpression = '';
    desktop.querySelectorAll<HTMLButtonElement>('[data-calculator-key]').forEach((key) => {
      key.addEventListener('click', () => {
        const value = key.dataset.calculatorKey ?? '';
        if (value === 'C') {
          calculatorValue = '';
          calculatorExpression = '';
        } else if (value === '=') {
          try {
            calculatorValue = String(Function(`return ${calculatorExpression}`)());
            calculatorExpression = calculatorValue;
          } catch {
            calculatorValue = 'ERR';
            calculatorExpression = '';
          }
        } else {
          calculatorExpression += value;
          calculatorValue = calculatorExpression;
        }
        if (calculatorDisplay) calculatorDisplay.textContent = calculatorValue || '0';
      });
    });

    const browserForm = desktop.querySelector<HTMLFormElement>('[data-browser-form]');
    const browserInput = desktop.querySelector<HTMLInputElement>('[data-browser-input]');
    const browserFrame = desktop.querySelector<HTMLIFrameElement>('[data-browser-frame]');
    const browserHome = desktop.querySelector<HTMLElement>('[data-browser-home]');
    const browserHistory: string[] = [];
    let browserIndex = -1;
    const loadBrowserUrl = (url: string, addHistory = true) => {
      if (!/^https?:\/\//i.test(url)) url = `https://${url}`;
      if (addHistory) {
        browserHistory.splice(browserIndex + 1);
        browserHistory.push(url);
        browserIndex = browserHistory.length - 1;
      }
      if (browserInput) browserInput.value = url;
      if (browserFrame) {
        browserFrame.hidden = false;
        browserFrame.src = url;
      }
      if (browserHome) browserHome.hidden = true;
    };
    browserForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (browserInput?.value) loadBrowserUrl(browserInput.value);
    });
    desktop.querySelectorAll<HTMLButtonElement>('[data-browser-link]').forEach((link) => link.addEventListener('click', () => loadBrowserUrl(link.dataset.browserLink ?? '')));
    desktop.querySelector('[data-browser-back]')?.addEventListener('click', () => { if (browserIndex > 0) { browserIndex -= 1; loadBrowserUrl(browserHistory[browserIndex], false); } });
    desktop.querySelector('[data-browser-forward]')?.addEventListener('click', () => { if (browserIndex < browserHistory.length - 1) { browserIndex += 1; loadBrowserUrl(browserHistory[browserIndex], false); } });
    desktop.querySelector('[data-browser-refresh]')?.addEventListener('click', () => { if (browserFrame?.src) browserFrame.src = browserFrame.src; });
  }
</script>