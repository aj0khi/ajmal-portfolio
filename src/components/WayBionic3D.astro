<section class="waybionic-3d" data-ik-simulation>
  <div class="ik-header">
    <div>
      <p class="window-kicker mono">OPTIONAL WEBGL MODULE / SIMULATION ONLY</p>
      <h3>Drag the target.<br /><em>Watch the arm solve.</em></h3>
    </div>
    <button type="button" class="ik-start" data-ik-start>INITIALIZE SIMULATION</button>
  </div>
  <div class="ik-stage" data-ik-stage hidden>
    <canvas data-ik-canvas aria-label="Interactive simulated six degree of freedom robotic arm"></canvas>
    <div class="ik-readout">
      <div><span>MODE</span><strong data-ik-mode>SIMULATION</strong></div>
      <div><span>JOINTS</span><strong>5 DOF + MIMIC</strong></div>
      <div><span>TARGET</span><strong data-ik-target>TRACKING</strong></div>
      <div><span>LIMITS</span><strong data-ik-limits>NOMINAL</strong></div>
    </div>
  </div>
  <p class="ik-note" data-ik-note>Nothing is connected to a robot. This uses the current five-actuated-joint URDF shape; limits remain provisional in the source workspace.</p>
</section>

<script>
  const simulation = document.querySelector<HTMLElement>('[data-ik-simulation]');
  const startButton = simulation?.querySelector<HTMLButtonElement>('[data-ik-start]');
  const stage = simulation?.querySelector<HTMLElement>('[data-ik-stage]');
  const note = simulation?.querySelector<HTMLElement>('[data-ik-note]');

  startButton?.addEventListener('click', async () => {
    if (!simulation || !stage || !startButton) return;
    startButton.disabled = true;
    startButton.textContent = 'LOADING WEBGL...';
    stage.hidden = false;

    try {
      const THREE = await import('three');
      const canvas = stage.querySelector<HTMLCanvasElement>('[data-ik-canvas]');
      const targetLabel = stage.querySelector<HTMLElement>('[data-ik-target]');
      const limitsLabel = stage.querySelector<HTMLElement>('[data-ik-limits]');
      if (!canvas) throw new Error('Simulation canvas unavailable.');

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x1e2932);
      const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
      camera.position.set(3.2, 2.4, 5.8);
      camera.lookAt(0, 1.2, 0);
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

      const target = new THREE.Mesh(
        new THREE.SphereGeometry(0.13, 20, 20),
        new THREE.MeshBasicMaterial({ color: 0xcd752a })
      );
      target.position.set(1.3, 1.9, 0.2);
      scene.add(target);

      const segmentLength = 0.48;
      const points = Array.from({ length: 7 }, (_, index) => new THREE.Vector3(0, index * segmentLength, 0));
      const joints = points.slice(0, 6).map(() => new THREE.Mesh(
        new THREE.SphereGeometry(0.075, 12, 12),
        new THREE.MeshBasicMaterial({ color: 0xe5c86e })
      ));
      joints.forEach((joint, index) => { joint.position.copy(points[index]); scene.add(joint); });
      const armGeometry = new THREE.BufferGeometry().setFromPoints(points);
      const armLine = new THREE.Line(armGeometry, new THREE.LineBasicMaterial({ color: 0x8fc66b }));
      scene.add(armLine);

      const grid = new THREE.GridHelper(6, 12, 0x496375, 0x2f414b);
      grid.position.y = -0.02;
      scene.add(grid);

      const resize = () => {
        const bounds = canvas.getBoundingClientRect();
        renderer.setSize(bounds.width, bounds.height, false);
        camera.aspect = bounds.width / Math.max(bounds.height, 1);
        camera.updateProjectionMatrix();
      };
      resize();
      window.addEventListener('resize', resize);

      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();
      const dragPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
      const hit = new THREE.Vector3();
      let dragging = false;
      const updateTarget = (event: PointerEvent) => {
        const bounds = canvas.getBoundingClientRect();
        pointer.x = ((event.clientX - bounds.left) / bounds.width) * 2 - 1;
        pointer.y = -((event.clientY - bounds.top) / bounds.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        if (raycaster.ray.intersectPlane(dragPlane, hit)) {
          target.position.x = Math.max(-2.5, Math.min(2.5, hit.x));
          target.position.y = Math.max(0.2, Math.min(3.5, hit.y));
          const outOfReach = target.position.length() > 2.9;
          target.material.color.set(outOfReach ? 0x9a3e32 : 0xcd752a);
          if (targetLabel) targetLabel.textContent = outOfReach ? 'OUT OF REACH' : 'TRACKING';
          if (limitsLabel) limitsLabel.textContent = outOfReach ? 'LIMIT HIT' : 'NOMINAL';
        }
      };
      canvas.addEventListener('pointerdown', (event) => { dragging = true; canvas.setPointerCapture(event.pointerId); updateTarget(event); });
      canvas.addEventListener('pointermove', (event) => { if (dragging) updateTarget(event); });
      canvas.addEventListener('pointerup', () => { dragging = false; });

      startButton.textContent = 'SIMULATION ACTIVE';
      if (note) note.textContent = 'Drag the orange target. Joint limits are represented visually; this remains a browser-only simulation.';
      const animate = () => {
        const root = points[0].clone();
        const reach = root.distanceTo(target.position);
        const totalLength = segmentLength * 6;
        if (reach >= totalLength) {
          for (let index = 1; index < points.length; index += 1) {
            points[index].copy(points[index - 1]).lerp(target.position, segmentLength / points[index - 1].distanceTo(target.position));
          }
        } else {
          for (let iteration = 0; iteration < 8; iteration += 1) {
            points[points.length - 1].copy(target.position);
            for (let index = points.length - 2; index >= 0; index -= 1) {
              const direction = points[index].clone().sub(points[index + 1]).normalize();
              points[index].copy(points[index + 1]).addScaledVector(direction, segmentLength);
            }
            points[0].copy(root);
            for (let index = 1; index < points.length; index += 1) {
              const direction = points[index].clone().sub(points[index - 1]).normalize();
              points[index].copy(points[index - 1]).addScaledVector(direction, segmentLength);
            }
          }
        }
        armGeometry.setFromPoints(points);
        joints.forEach((joint, index) => joint.position.copy(points[index]));
        renderer.render(scene, camera);
        requestAnimationFrame(animate);
      };
      animate();
    } catch (error) {
      stage.hidden = true;
      startButton.disabled = false;
      startButton.textContent = 'RETRY SIMULATION';
      if (note) note.textContent = error instanceof Error ? error.message : 'WebGL or the IK module is unavailable on this device.';
    }
  });
</script>
