<section class="waybionic-3d" data-ik-simulation>
  <div class="ik-header">
    <div>
      <p class="window-kicker mono">OPTIONAL WEBGL MODULE / SIMULATION ONLY</p>
      <h3>Drag the target.<br /><em>Watch the arm solve.</em></h3>
    </div>
    <button type="button" class="ik-start" data-ik-start>INITIALIZE SIMULATION</button>
  </div>
  <div class="ik-stage" data-ik-stage hidden>
    <canvas data-ik-canvas aria-label="Interactive simulated four joint old-arm motion test"></canvas>
    <div class="ik-overlay mono" aria-hidden="true"><span>FABRIK / 8 PASSES</span><span>LOCAL WEBGL</span></div>
    <div class="ik-readout">
      <div><span>MODE</span><strong data-ik-mode>SIMULATION</strong></div>
      <div><span>JOINTS</span><strong>4 JOINT OLD ARM</strong></div>
      <div><span>TARGET</span><strong data-ik-target>TRACKING</strong></div>
      <div><span>LIMITS</span><strong data-ik-limits>NOMINAL</strong></div>
    </div>
  </div>
  <p class="ik-note" data-ik-note>Nothing is connected to a robot. This represents the old-arm motion test; drag the cyan target to explore reach. The source bridge reports 0–270° physical ranges, while calibration remains a hardware concern.</p>
</section>

<script>
  const simulation = document.querySelector<HTMLElement>('[data-ik-simulation]');
  const startButton = simulation?.querySelector<HTMLButtonElement>('[data-ik-start]');
  const stage = simulation?.querySelector<HTMLElement>('[data-ik-stage]');
  const note = simulation?.querySelector<HTMLElement>('[data-ik-note]');

  startButton?.addEventListener('click', async () => {
    if (!simulation || !stage || !startButton) return;
    startButton.disabled = true;
    startButton.textContent = 'LOADING WEBGL...';
    stage.hidden = false;

    try {
      const THREE = await import('three');
      const canvas = stage.querySelector<HTMLCanvasElement>('[data-ik-canvas]');
      const targetLabel = stage.querySelector<HTMLElement>('[data-ik-target]');
      const limitsLabel = stage.querySelector<HTMLElement>('[data-ik-limits]');
      if (!canvas) throw new Error('Simulation canvas unavailable.');

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x1e2932);
      const camera = new THREE.PerspectiveCamera(42, 1, 0.1, 100);
      camera.position.set(3.2, 2.4, 5.8);
      camera.lookAt(0, 1.2, 0);
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      scene.add(new THREE.HemisphereLight(0xdfe7e0, 0x14202a, 2.1));
      const keyLight = new THREE.DirectionalLight(0x8fc6d8, 2.4);
      keyLight.position.set(3, 4, 5);
      scene.add(keyLight);

      const target = new THREE.Mesh(
        new THREE.SphereGeometry(0.13, 20, 20),
        new THREE.MeshStandardMaterial({ color: 0x4a97aa, emissive: 0x173f52, emissiveIntensity: 0.5, roughness: 0.35 })
      );
      target.position.set(1.3, 1.9, 0.2);
      scene.add(target);
      const targetReticle = new THREE.Mesh(
        new THREE.TorusGeometry(0.25, 0.012, 8, 32),
        new THREE.MeshBasicMaterial({ color: 0x8fc6d8, transparent: true, opacity: 0.75 })
      );
      targetReticle.rotation.x = Math.PI / 2;
      targetReticle.position.copy(target.position);
      scene.add(targetReticle);

      const segmentLength = 0.48;
      const points = Array.from({ length: 5 }, (_, index) => new THREE.Vector3(0, index * segmentLength, 0));
      const jointMaterial = new THREE.MeshStandardMaterial({ color: 0xa6b989, roughness: 0.42, metalness: 0.12 });
      const linkMaterial = new THREE.MeshStandardMaterial({ color: 0xdfe7e0, roughness: 0.55, metalness: 0.18 });
      const joints = points.slice(0, 4).map(() => new THREE.Mesh(
        new THREE.SphereGeometry(0.075, 12, 12),
        jointMaterial
      ));
      joints.forEach((joint, index) => { joint.position.copy(points[index]); scene.add(joint); });
      const segmentMeshes = points.slice(0, 4).map(() => new THREE.Mesh(
        new THREE.CylinderGeometry(0.055, 0.08, segmentLength, 14),
        linkMaterial
      ));
      segmentMeshes.forEach((segment) => scene.add(segment));
      const base = new THREE.Mesh(
        new THREE.CylinderGeometry(0.38, 0.46, 0.16, 24),
        new THREE.MeshStandardMaterial({ color: 0x496375, roughness: 0.48, metalness: 0.3 })
      );
      base.position.y = -0.1;
      scene.add(base);
      const endEffector = new THREE.Mesh(
        new THREE.BoxGeometry(0.22, 0.12, 0.16),
        new THREE.MeshStandardMaterial({ color: 0x8fc6d8, roughness: 0.35, metalness: 0.25 })
      );
      scene.add(endEffector);
      const armGeometry = new THREE.BufferGeometry().setFromPoints(points);
      const armLine = new THREE.Line(armGeometry, new THREE.LineBasicMaterial({ color: 0x4a97aa, transparent: true, opacity: 0.45 }));
      scene.add(armLine);
      const baseAxes = new THREE.AxesHelper(0.4);
      scene.add(baseAxes);

      const grid = new THREE.GridHelper(6, 12, 0x496375, 0x2f414b);
      grid.position.y = -0.02;
      scene.add(grid);

      const resize = () => {
        const bounds = canvas.getBoundingClientRect();
        renderer.setSize(bounds.width, bounds.height, false);
        camera.aspect = bounds.width / Math.max(bounds.height, 1);
        camera.updateProjectionMatrix();
      };
      resize();
      window.addEventListener('resize', resize);

      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();
      const dragPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
      const hit = new THREE.Vector3();
      let dragging = false;
      const updateTarget = (event: PointerEvent) => {
        const bounds = canvas.getBoundingClientRect();
        pointer.x = ((event.clientX - bounds.left) / bounds.width) * 2 - 1;
        pointer.y = -((event.clientY - bounds.top) / bounds.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        if (raycaster.ray.intersectPlane(dragPlane, hit)) {
          target.position.x = Math.max(-2.5, Math.min(2.5, hit.x));
          target.position.y = Math.max(0.2, Math.min(3.5, hit.y));
          targetReticle.position.copy(target.position);
          const outOfReach = target.position.length() > 2.9;
          target.material.color.set(outOfReach ? 0x9a3e32 : 0x4a97aa);
          if (targetLabel) targetLabel.textContent = outOfReach ? 'OUT OF REACH' : 'TRACKING';
          if (limitsLabel) limitsLabel.textContent = outOfReach ? 'LIMIT HIT' : 'NOMINAL';
        }
      };
      canvas.addEventListener('pointerdown', (event) => { dragging = true; canvas.setPointerCapture(event.pointerId); updateTarget(event); });
      canvas.addEventListener('pointermove', (event) => { if (dragging) updateTarget(event); });
      canvas.addEventListener('pointerup', () => { dragging = false; });

      startButton.textContent = 'SIMULATION ACTIVE';
      if (note) note.textContent = 'Drag the cyan target. Joint limits are represented visually; this remains a browser-only simulation.';
      const animate = () => {
        const root = points[0].clone();
        const reach = root.distanceTo(target.position);
        const totalLength = segmentLength * 4;
        if (reach >= totalLength) {
          for (let index = 1; index < points.length; index += 1) {
            points[index].copy(points[index - 1]).lerp(target.position, segmentLength / points[index - 1].distanceTo(target.position));
          }
        } else {
          for (let iteration = 0; iteration < 8; iteration += 1) {
            points[points.length - 1].copy(target.position);
            for (let index = points.length - 2; index >= 0; index -= 1) {
              const direction = points[index].clone().sub(points[index + 1]).normalize();
              points[index].copy(points[index + 1]).addScaledVector(direction, segmentLength);
            }
            points[0].copy(root);
            for (let index = 1; index < points.length; index += 1) {
              const direction = points[index].clone().sub(points[index - 1]).normalize();
              points[index].copy(points[index - 1]).addScaledVector(direction, segmentLength);
            }
          }
        }
        armGeometry.setFromPoints(points);
        joints.forEach((joint, index) => joint.position.copy(points[index]));
        segmentMeshes.forEach((segment, index) => {
          const start = points[index];
          const end = points[index + 1];
          const midpoint = start.clone().add(end).multiplyScalar(0.5);
          const direction = end.clone().sub(start);
          segment.position.copy(midpoint);
          segment.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), direction.normalize());
        });
        endEffector.position.copy(points[4]);
        if (points[3].distanceTo(points[4]) > 0.001) {
          endEffector.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), points[4].clone().sub(points[3]).normalize());
        }
        renderer.render(scene, camera);
        requestAnimationFrame(animate);
      };
      animate();
    } catch (error) {
      stage.hidden = true;
      startButton.disabled = false;
      startButton.textContent = 'RETRY SIMULATION';
      if (note) note.textContent = error instanceof Error ? error.message : 'WebGL or the IK module is unavailable on this device.';
    }
  });
</script>
