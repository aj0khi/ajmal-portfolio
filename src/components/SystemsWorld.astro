<section class="systems-world" data-systems-world>
  <div class="systems-world-stage">
    <canvas data-world-canvas aria-label="Interactive 3D Systems Field"></canvas>
    <div class="world-reticle" aria-hidden="true"></div>
    <div class="world-hud mono">
      <div><span>AJMALOS / FIELD MODE</span><strong data-world-status>WALK TO A STATION</strong></div>
      <div class="world-hud-right"><span>WASD MOVE / SHIFT SPRINT / SPACE JUMP / E INSPECT</span><span data-world-coordinates>SECTOR 00 / 00</span><span data-world-progress>ARCHIVE 0 / 8</span><button type="button" data-world-desktop>OPEN OS DESKTOP</button></div>
    </div>
    <div class="world-prompt" data-world-prompt hidden>
      <span class="mono" data-world-prompt-kicker>STATION DETECTED</span>
      <strong data-world-prompt-title>PROJECT</strong>
      <p data-world-prompt-copy>Press E to inspect this system.</p>
      <button type="button" data-world-open>INSPECT SYSTEM ↗</button>
    </div>
    <div class="world-legend">
      <span class="mono">FIELD STATIONS</span>
      <div><i class="legend-waybionic"></i>WAYBIONIC</div>
      <div><i class="legend-blackbox"></i>BLACKBOX</div>
      <div><i class="legend-rover"></i>ROVER</div>
      <div><i class="legend-hvac"></i>HVAC LAB</div>
      <div><i class="legend-profile"></i>ABOUT AJMAL</div>
    </div>
    <div class="world-compass mono" aria-hidden="true"><span>N</span><b></b><span>E</span></div>
    <div class="world-toast mono" data-world-toast hidden>ARCHIVE SHARD RECOVERED</div>
  </div>
  <p class="world-note mono">A walkable archive of systems, experiments, and working notes. No account. No score. Just explore.</p>
</section>

<script>
  const world = document.querySelector<HTMLElement>('[data-systems-world]');
  const canvas = world?.querySelector<HTMLCanvasElement>('[data-world-canvas]');
  const status = world?.querySelector<HTMLElement>('[data-world-status]');
  const coordinates = world?.querySelector<HTMLElement>('[data-world-coordinates]');
  const prompt = world?.querySelector<HTMLElement>('[data-world-prompt]');
  const promptTitle = world?.querySelector<HTMLElement>('[data-world-prompt-title]');
  const promptCopy = world?.querySelector<HTMLElement>('[data-world-prompt-copy]');
  const openButton = world?.querySelector<HTMLButtonElement>('[data-world-open]');
  const progress = world?.querySelector<HTMLElement>('[data-world-progress]');
  const toast = world?.querySelector<HTMLElement>('[data-world-toast]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (world && canvas && !world.dataset.initialized) {
    world.dataset.initialized = 'true';
    const launch = async () => {
      try {
        const THREE = await import('three');
        const { GLTFLoader } = await import('three/addons/loaders/GLTFLoader.js');
        const glbLoader = new GLTFLoader();
        const loadImportedModel = (path: string, parent: InstanceType<typeof THREE.Object3D>, position: [number, number, number], targetSize: number, rotationY = 0, onLoaded?: (model: InstanceType<typeof THREE.Object3D>) => void) => {
          glbLoader.load(path, (gltf) => {
            const model = gltf.scene;
            const bounds = new THREE.Box3().setFromObject(model);
            const size = bounds.getSize(new THREE.Vector3());
            const largestDimension = Math.max(size.x, size.y, size.z, 0.001);
            const scale = targetSize / largestDimension;
            model.scale.setScalar(scale);
            const centeredBounds = new THREE.Box3().setFromObject(model);
            const center = centeredBounds.getCenter(new THREE.Vector3());
            model.position.set(position[0] - center.x, position[1] - centeredBounds.min.y, position[2] - center.z);
            model.rotation.y = rotationY;
            model.traverse((object) => { object.castShadow = true; object.receiveShadow = true; });
            parent.add(model);
            onLoaded?.(model);
          }, undefined, () => undefined);
        };
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x74c4df);
        scene.fog = new THREE.Fog(0x74c4df, 8, 21);
        const camera = new THREE.PerspectiveCamera(58, 1, 0.1, 32);
        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(devicePixelRatio, 1.35));
        scene.add(new THREE.HemisphereLight(0xf5ffff, 0x1d5b59, 1.45));
        const keyLight = new THREE.DirectionalLight(0xffffff, 2.4);
        keyLight.position.set(-4, 8, 5);
        scene.add(keyLight);
        const warmLight = new THREE.PointLight(0xd8ed77, 2.2, 8);
        warmLight.position.set(0, 2.5, -2);
        scene.add(warmLight);

        const ground = new THREE.Mesh(
          new THREE.PlaneGeometry(18, 18),
          new THREE.MeshStandardMaterial({ color: 0x348f79, roughness: 0.82, metalness: 0.08 })
        );
        ground.rotation.x = -Math.PI / 2;
        scene.add(ground);
        const grid = new THREE.GridHelper(18, 18, 0x9ce1d0, 0x4b9b91);
        grid.position.y = 0.015;
        scene.add(grid);

        const wallMaterial = new THREE.MeshStandardMaterial({ color: 0x2d816f, roughness: 0.82 });
        const wallBack = new THREE.Mesh(new THREE.BoxGeometry(14, 2.2, 0.2), wallMaterial);
        wallBack.position.set(0, 1.1, -7);
        scene.add(wallBack);
        const wallLeft = new THREE.Mesh(new THREE.BoxGeometry(0.2, 2.2, 14), wallMaterial);
        wallLeft.position.set(-7, 1.1, 0);
        scene.add(wallLeft);

        const architecture = new THREE.Group();
        const colliders: Array<{ minX: number; maxX: number; minZ: number; maxZ: number; top: number }> = [];
        colliders.push({ minX: -7, maxX: 7, minZ: -7.2, maxZ: -6.7, top: 2.2 }, { minX: -7.2, maxX: -6.7, minZ: -7, maxZ: 7, top: 2.2 });
        const platformMaterial = new THREE.MeshStandardMaterial({ color: 0x4ba794, roughness: 0.62, metalness: 0.16 });
        const trimMaterial = new THREE.MeshStandardMaterial({ color: 0xe9fff1, roughness: 0.3, metalness: 0.22 });
        const addBox = (size: [number, number, number], position: [number, number, number], material = platformMaterial, rotation?: [number, number, number], collidable = false) => {
          const box = new THREE.Mesh(new THREE.BoxGeometry(...size), material);
          box.position.set(...position);
          if (rotation) box.rotation.set(...rotation);
          architecture.add(box);
          if (collidable && !rotation) colliders.push({ minX: position[0] - size[0] / 2, maxX: position[0] + size[0] / 2, minZ: position[2] - size[2] / 2, maxZ: position[2] + size[2] / 2, top: position[1] + size[1] / 2 });
          return box;
        };
        const addColumn = (x: number, z: number, height: number) => addBox([0.18, height, 0.18], [x, height / 2, z], trimMaterial);
        addBox([5.2, 0.22, 1.7], [-2.2, 0.65, -2.9], platformMaterial, undefined, true);
        [-4.2, -2.2, -0.2].forEach((x) => addColumn(x, -2.9, 0.65));
        addBox([7.5, 0.2, 1], [0, 1.75, -0.45], trimMaterial);
        [-3.4, 0, 3.4].forEach((x) => { addColumn(x, -0.45, 1.75); addBox([0.6, 0.08, 1.15], [x, 1.92, -0.45], platformMaterial); });
        addBox([3.4, 0.18, 2.4], [2.2, 0.55, 2.4], platformMaterial, [-0.18, 0, 0]);
        addBox([3.4, 0.18, 2.2], [-2.4, 0.35, 1.1], platformMaterial, [0.12, 0, 0]);
        [-3.8, -1, 1.8, 4.4].forEach((x) => addColumn(x, 2.1, 1.8));
        addBox([8.2, 0.16, 0.36], [0.3, 1.8, 2.1], trimMaterial);
        const arch = new THREE.Mesh(new THREE.TorusGeometry(1.25, 0.1, 10, 28, Math.PI), new THREE.MeshStandardMaterial({ color: 0x68e0d5, emissive: 0x1e6f78, emissiveIntensity: 0.32, roughness: 0.3, metalness: 0.2 }));
        arch.rotation.z = Math.PI / 2;
        arch.position.set(0, 1.25, 1.1);
        architecture.add(arch);
        addBox([2.8, 0.22, 2.8], [4.1, 1.3, -4.7], trimMaterial);
        addColumn(3, -4.7, 1.3); addColumn(5.2, -4.7, 1.3);
        const rampGlow = new THREE.Mesh(new THREE.BoxGeometry(2.2, 0.03, 0.06), new THREE.MeshBasicMaterial({ color: 0xd8ed77 }));
        rampGlow.position.set(-2.4, 0.74, 1.1);
        architecture.add(rampGlow);
        scene.add(architecture);

        const player = new THREE.Group();
        const playerBody = new THREE.Mesh(new THREE.CapsuleGeometry(0.16, 0.34, 4, 10), new THREE.MeshStandardMaterial({ color: 0xd8ed77, emissive: 0x435d1e, emissiveIntensity: 0.4 }));
        playerBody.position.y = 0.4;
        player.add(playerBody);
        const playerLight = new THREE.PointLight(0xd8ed77, 1.8, 2.8);
        playerLight.position.y = 0.65;
        player.add(playerLight);
        player.position.set(0, 0, 4.8);
        scene.add(player);
        loadImportedModel('/assets/models/simple_character.glb', player, [0, 0, 0], 1.25, Math.PI);

        loadImportedModel('/assets/models/animated_ocean_scene_tutorial_example_1.glb', scene, [0, -0.12, -7], 12, 0);
        loadImportedModel('/assets/models/frutiger_aero_buildings.glb', scene, [0, 0, -5.8], 7.5, 0);
        loadImportedModel('/assets/models/futuristic_building_props.glb', scene, [0, 0, -3], 4.8, 0);
        loadImportedModel('/assets/models/bridge.glb', scene, [0, 1.65, -0.45], 7.5, 0);
        loadImportedModel('/assets/models/floating_island.glb', scene, [-4.3, 2.7, -4.5], 3.6, 0.3);
        loadImportedModel('/assets/models/floating_island_paint_test.glb', scene, [4.4, 2.3, -4.1], 2.7, -0.4);
        loadImportedModel('/assets/models/palm_trees.glb', scene, [-5.1, 0, 2.6], 3.8, 0.2);
        loadImportedModel('/assets/models/small_rocks.glb', scene, [3.6, 0, 2.8], 2.2, 0);
        loadImportedModel('/assets/models/stylized_crystal_gems_asset_pack.glb', scene, [0.2, 0, 1.9], 1.6, 0);
        loadImportedModel('/assets/models/clouds.glb', scene, [0, 4.8, -3.5], 7, 0);
        const playerVelocity = new THREE.Vector3();
        let cameraDistance = 4.6;

        const stationData = [
          { id: 'waybionic', title: 'WAYBIONIC', copy: 'ROS2 ground station / movement diagnostics', position: [-4.4, -2.2], color: 0x68e0d5, type: 'arm' },
          { id: 'blackbox', title: 'BLACKBOX', copy: 'Evidence chain / local-first physical AI', position: [0, -4.6], color: 0xd8ed77, type: 'vault' },
          { id: 'rover', title: 'ROVER', copy: 'Sonar / decision logic / motor control', position: [4.2, -1.8], color: 0x69bced, type: 'rover' },
          { id: 'hvacsim', title: 'HVAC LAB', copy: 'Comfort calculation / practical delivery', position: [-4.2, 2.8], color: 0xffb38b, type: 'fan' },
          { id: 'system', title: 'ABOUT AJMAL', copy: 'Profile / resume / contact / next system', position: [4, 3], color: 0xd8ed77, type: 'profile' }
        ];
        type Station = { position: InstanceType<typeof THREE.Vector3>; rotation: { y: number }; scale: { lerp: (target: InstanceType<typeof THREE.Vector3>, alpha: number) => void }; userData: typeof stationData[number] };
        const stations: Station[] = [];
        const stationMaterial = (color: number) => new THREE.MeshStandardMaterial({ color, emissive: color, emissiveIntensity: 0.24, roughness: 0.34, metalness: 0.28 });
        stationData.forEach((data) => {
          const group = new THREE.Group();
          const base = new THREE.Mesh(new THREE.CylinderGeometry(0.62, 0.78, 0.16, 20), new THREE.MeshStandardMaterial({ color: 0x204b5a, roughness: 0.6, metalness: 0.2 }));
          base.position.y = 0.08;
          group.add(base);
          const material = stationMaterial(data.color);
          if (data.type === 'arm') {
            const links = [[0, 0.3, 0], [0.45, 0.72, 0], [0.05, 1.1, 0]].map((point) => { const joint = new THREE.Mesh(new THREE.SphereGeometry(0.13, 12, 12), material); joint.position.set(point[0], point[1], point[2]); group.add(joint); return joint; });
            links.slice(0, -1).forEach((joint, index) => { const next = links[index + 1]; const direction = next.position.clone().sub(joint.position); const link = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.08, direction.length(), 10), material); link.position.copy(joint.position.clone().add(next.position).multiplyScalar(0.5)); link.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), direction.normalize()); group.add(link); });
          } else if (data.type === 'vault') {
            const vault = new THREE.Mesh(new THREE.BoxGeometry(0.92, 0.82, 0.82), material); vault.position.y = 0.55; group.add(vault);
            const seal = new THREE.Mesh(new THREE.TorusGeometry(0.2, 0.035, 8, 20), new THREE.MeshBasicMaterial({ color: 0x0b1722 })); seal.position.set(0, 0.55, 0.43); group.add(seal);
          } else if (data.type === 'rover') {
            const body = new THREE.Mesh(new THREE.BoxGeometry(1.05, 0.35, 0.72), material); body.position.y = 0.38; group.add(body);
            [-0.42, 0.42].forEach((x) => [-0.34, 0.34].forEach((z) => { const wheel = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, 0.1, 12), new THREE.MeshStandardMaterial({ color: 0x132b39, roughness: 0.6 })); wheel.rotation.x = Math.PI / 2; wheel.position.set(x, 0.12, z); group.add(wheel); }));
          } else if (data.type === 'fan') {
            const housing = new THREE.Mesh(new THREE.CylinderGeometry(0.56, 0.56, 0.2, 20), material); housing.rotation.z = Math.PI / 2; housing.position.y = 0.58; group.add(housing);
            for (let index = 0; index < 4; index += 1) { const blade = new THREE.Mesh(new THREE.BoxGeometry(0.07, 0.38, 0.05), new THREE.MeshStandardMaterial({ color: 0xffd3b8, emissive: 0x6d3023, emissiveIntensity: 0.18 })); blade.position.set(0, 0.58, 0.18); blade.rotation.z = index * Math.PI / 2; group.add(blade); }
          } else {
            const core = new THREE.Mesh(new THREE.OctahedronGeometry(0.48, 0), material); core.position.y = 0.58; group.add(core);
          }
          group.position.set(data.position[0], 0, data.position[1]);
          group.userData = data;
          const fallbackPieces = [...group.children];
          glbLoader.load(`/assets/models/${data.id}.glb`, (gltf) => {
            const importedModel = gltf.scene;
            const bounds = new THREE.Box3().setFromObject(importedModel);
            const size = bounds.getSize(new THREE.Vector3());
            const largestDimension = Math.max(size.x, size.y, size.z, 0.001);
            importedModel.scale.setScalar(1.35 / largestDimension);
            const centeredBounds = new THREE.Box3().setFromObject(importedModel);
            const center = centeredBounds.getCenter(new THREE.Vector3());
            importedModel.position.x -= center.x;
            importedModel.position.z -= center.z;
            importedModel.position.y -= centeredBounds.min.y;
            importedModel.traverse((object) => { object.castShadow = true; object.receiveShadow = true; });
            fallbackPieces.forEach((piece) => { piece.visible = false; });
            group.add(importedModel);
          }, undefined, () => undefined);
          scene.add(group);
          stations.push(group as unknown as Station);
        });

        const shardPositions = [[-5.2, 0.72, -5.2], [-2.2, 2.05, -2.9], [1.7, 0.6, -4.2], [4.8, 0.7, -3.4], [-5.1, 0.8, 1.8], [0, 1.95, 2.1], [3.6, 0.8, 2.8], [5.3, 0.8, 5.1]];
        const shards: Array<{ group: InstanceType<typeof THREE.Group>; collected: boolean }> = [];
        shardPositions.forEach((position, index) => {
          const shardGroup = new THREE.Group();
          const shard = new THREE.Mesh(new THREE.OctahedronGeometry(0.14, 0), new THREE.MeshStandardMaterial({ color: index % 2 ? 0xd8ed77 : 0x68e0d5, emissive: index % 2 ? 0x6c7a2d : 0x246f78, emissiveIntensity: 0.5, roughness: 0.22, metalness: 0.35 }));
          const ring = new THREE.Mesh(new THREE.TorusGeometry(0.26, 0.018, 8, 20), new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.75 }));
          ring.rotation.x = Math.PI / 2;
          shardGroup.add(shard, ring);
          shardGroup.position.set(position[0], position[1], position[2]);
          shardGroup.userData.baseY = position[1];
          scene.add(shardGroup);
          shards.push({ group: shardGroup, collected: false });
        });

        const keys: Record<string, boolean> = {};
        let selected: Station | null = null;
        let verticalVelocity = 0;
        let grounded = true;
        let collectedShards = 0;
        const setSelected = (station: Station | null) => {
          selected = station;
          if (!prompt || !promptTitle || !promptCopy || !status || !openButton) return;
          if (!station) { prompt.hidden = true; status.textContent = 'WALK TO A STATION'; openButton.dataset.windowOpen = ''; return; }
          const data = station.userData;
          prompt.hidden = false;
          promptTitle.textContent = data.title;
          promptCopy.textContent = data.copy;
          status.textContent = `${data.title} / IN RANGE`;
          openButton.dataset.windowOpen = data.id;
        };
        const updateSelection = () => {
          let nearest: Station | null = null;
          let distance = 999;
          stations.forEach((station) => { const nextDistance = station.position.distanceTo(player.position); if (nextDistance < distance) { distance = nextDistance; nearest = station; } });
          setSelected(distance < 1.65 ? nearest : null);
        };
        const inspect = () => { if (selected) document.querySelector<HTMLButtonElement>(`button[data-window-open="${selected.userData.id}"]`)?.click(); };
        addEventListener('keydown', (event) => { keys[event.key.toLowerCase()] = true; if (event.key.toLowerCase() === 'e') inspect(); if (event.code === 'Space' && grounded) { verticalVelocity = 5.2; grounded = false; } });
        addEventListener('keyup', (event) => { keys[event.key.toLowerCase()] = false; });
        openButton?.addEventListener('click', inspect);
        canvas.addEventListener('pointerdown', inspect);
        canvas.addEventListener('wheel', (event) => { event.preventDefault(); cameraDistance = Math.max(3.2, Math.min(7.2, cameraDistance + event.deltaY * 0.004)); }, { passive: false });

        const resize = () => { const bounds = canvas.getBoundingClientRect(); renderer.setSize(bounds.width, bounds.height, false); camera.aspect = bounds.width / Math.max(bounds.height, 1); camera.updateProjectionMatrix(); };
        resize();
        const observer = new ResizeObserver(resize);
        observer.observe(canvas.parentElement ?? canvas);
        let lastTime = performance.now();
        const collides = (x: number, z: number) => colliders.some((collider) => x > collider.minX - 0.24 && x < collider.maxX + 0.24 && z > collider.minZ - 0.24 && z < collider.maxZ + 0.24 && player.position.y < collider.top + 0.65);
        const movePlayer = (deltaX: number, deltaZ: number) => {
          const nextX = Math.max(-5.8, Math.min(5.8, player.position.x + deltaX));
          const nextZ = Math.max(-5.8, Math.min(5.8, player.position.z + deltaZ));
          if (!collides(nextX, player.position.z)) player.position.x = nextX;
          if (!collides(player.position.x, nextZ)) player.position.z = nextZ;
        };
        const animate = () => {
          const now = performance.now();
          const delta = Math.min((now - lastTime) / 1000, 0.05);
          lastTime = now;
          const inputX = Number(Boolean(keys.d || keys.arrowright)) - Number(Boolean(keys.a || keys.arrowleft));
          const inputZ = Number(Boolean(keys.s || keys.arrowdown)) - Number(Boolean(keys.w || keys.arrowup));
          const inputLength = Math.hypot(inputX, inputZ) || 1;
          const maxSpeed = keys.shift ? 4.8 : 2.8;
          const targetVelocityX = (inputX / inputLength) * maxSpeed;
          const targetVelocityZ = (inputZ / inputLength) * maxSpeed;
          const response = Math.min(delta * 12, 1);
          playerVelocity.x += (targetVelocityX - playerVelocity.x) * response;
          playerVelocity.z += (targetVelocityZ - playerVelocity.z) * response;
          if (!inputX && !inputZ) { playerVelocity.x *= Math.max(0, 1 - delta * 10); playerVelocity.z *= Math.max(0, 1 - delta * 10); }
          movePlayer(playerVelocity.x * delta, playerVelocity.z * delta);
          verticalVelocity -= 12 * delta;
          player.position.y += verticalVelocity * delta;
          if (player.position.y <= 0) { player.position.y = 0; verticalVelocity = 0; grounded = true; }
          shards.forEach((shard) => {
            if (shard.collected) return;
            shard.group.rotation.y += delta * 1.8;
            shard.group.position.y = shard.group.userData.baseY + Math.sin(now * 0.002 + shard.group.position.x) * 0.08;
            if (shard.group.position.distanceTo(player.position) < 0.65) {
              shard.collected = true;
              shard.group.visible = false;
              collectedShards += 1;
              if (progress) progress.textContent = `ARCHIVE ${collectedShards} / ${shards.length}`;
              if (toast) { toast.hidden = false; toast.textContent = collectedShards === shards.length ? 'ARCHIVE COMPLETE / ALL SHARDS RECOVERED' : 'ARCHIVE SHARD RECOVERED'; window.setTimeout(() => { toast.hidden = true; }, 1400); }
            }
          });
          camera.position.lerp(new THREE.Vector3(player.position.x, 2.8 + player.position.y * 0.35, player.position.z + cameraDistance), 0.12);
          camera.lookAt(player.position.x, 0.72 + player.position.y * 0.35, player.position.z - 1.25);
          stations.forEach((station, index) => { station.rotation.y += delta * (index % 2 ? -0.18 : 0.24); station.position.y = Math.sin(performance.now() * 0.001 + index) * 0.035; station.scale.lerp(new THREE.Vector3(station === selected ? 1.12 : 1, station === selected ? 1.12 : 1, station === selected ? 1.12 : 1), 0.12); });
          updateSelection();
          if (coordinates) coordinates.textContent = `SECTOR ${Math.round(player.position.x).toString().padStart(2, '0')} / ${Math.round(player.position.z).toString().padStart(2, '0')}`;
          renderer.render(scene, camera);
          requestAnimationFrame(animate);
        };
        animate();
      } catch {
        if (status) status.textContent = '3D MODULE UNAVAILABLE / USE WINDOWS';
      }
    };
    if (reduced) { if (status) status.textContent = 'REDUCED MOTION / USE WINDOWS'; } else if ('requestIdleCallback' in window) requestIdleCallback(launch); else setTimeout(launch, 500);
  }
</script>
