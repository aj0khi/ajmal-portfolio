---
import { contact } from '../../data/profile';
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <canvas class="hero-canvas" data-workcell aria-hidden="true"></canvas>
  <div class="hero-vignette" aria-hidden="true"></div>

  <div class="hero-copy shell">
    <p class="hero-name" data-hero-line>Ajmal Khidri</p>
    <h1 id="hero-title" class="hero-title">
      <span class="hero-line" data-hero-line>Systems</span>
      <span class="hero-line" data-hero-line>that move.</span>
    </h1>
    <p class="hero-lede" data-hero-line>
      Computer Science at the University of Calgary. I write ground-station software for a surgical robot arm, run the
      tech behind a Calgary HVAC company, and own a power-washing business. Physical systems that have to keep running
      are the common thread.
    </p>
    <div class="hero-actions" data-hero-line>
      <a class="btn btn-primary" href={contact.resume} download>Download resume</a>
      <a class="btn btn-ghost" href="#work">See the work</a>
    </div>
  </div>

  <aside class="readout" aria-label="Live readout from the demo arm" data-readout>
    <div class="readout-head">
      <span class="readout-topic">/joint_states</span>
      <span class="readout-state" data-ik-state>booting</span>
    </div>
    <dl class="readout-joints">
      <div><dt>base_yaw</dt><dd data-joint="0">0.0°</dd><i data-bar="0"></i></div>
      <div><dt>shoulder</dt><dd data-joint="1">0.0°</dd><i data-bar="1"></i></div>
      <div><dt>elbow</dt><dd data-joint="2">0.0°</dd><i data-bar="2"></i></div>
      <div><dt>wrist_pitch</dt><dd data-joint="3">0.0°</dd><i data-bar="3"></i></div>
    </dl>
    <div class="readout-tool">
      <span>tool mm <b data-tool>0, 0, 0</b></span>
      <span>reach <b data-reach>0</b>%</span>
    </div>
    <p class="readout-note">Move your cursor or tap. The arm solves inverse kinematics in your browser, at 60 frames a second. It is a demo arm, not the WayBionic robot.</p>
  </aside>

  <div class="hero-foot shell" data-hero-line>
    <span><i class="pulse" aria-hidden="true"></i>Open to software and robotics internships</span>
    <span>Calgary <b data-local-time>--:--</b> MT</span>
    <a href="#work" class="hero-scroll">Scroll</a>
  </div>
</section>

<script>
  type Vec2 = { x: number; y: number };

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-workcell]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const timeNode = hero?.querySelector<HTMLElement>('[data-local-time]');
  const tick = () => {
    if (timeNode) timeNode.textContent = new Date().toLocaleTimeString('en-CA', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Edmonton' });
  };
  tick();
  window.setInterval(tick, 20000);

  // Arm geometry in metres. The shoulder pivot sits above the turret; the tool is the
  // wrist-to-gripper-tip offset that the 2-link solver reaches around.
  const SHOULDER_H = 0.64;
  const L1 = 1.05;
  const L2 = 0.92;
  const L3 = 0.34;
  const TOOL_PITCH = -0.55; // radians: approach the target slightly from above
  const LIMITS = [
    [-170, 170],
    [-15, 155],
    [-160, -4],
    [-120, 120]
  ].map(([min, max]) => [(min * Math.PI) / 180, (max * Math.PI) / 180]);

  // Closed-form IK: yaw from the target's bearing, then a planar two-link solve for
  // the wrist centre, then the wrist angle that keeps the tool at TOOL_PITCH.
  const solve = (tx: number, ty: number, tz: number) => {
    const yaw = Math.atan2(-tz, tx);
    const r = Math.hypot(tx, tz);
    const h = ty - SHOULDER_H;
    const wrist: Vec2 = { x: r - L3 * Math.cos(TOOL_PITCH), y: h - L3 * Math.sin(TOOL_PITCH) };
    let distance = Math.hypot(wrist.x, wrist.y);
    const maxReach = L1 + L2 - 0.02;
    const minReach = Math.abs(L1 - L2) + 0.08;
    let limited = false;
    if (distance > maxReach || distance < minReach) {
      const clamped = Math.min(maxReach, Math.max(minReach, distance));
      wrist.x *= clamped / (distance || 1);
      wrist.y *= clamped / (distance || 1);
      distance = clamped;
      limited = true;
    }
    const cosElbow = (distance * distance - L1 * L1 - L2 * L2) / (2 * L1 * L2);
    const elbow = -Math.acos(Math.min(1, Math.max(-1, cosElbow)));
    const shoulder = Math.atan2(wrist.y, wrist.x) - Math.atan2(L2 * Math.sin(elbow), L1 + L2 * Math.cos(elbow));
    const wristPitch = TOOL_PITCH - shoulder - elbow;
    const raw = [yaw, shoulder, elbow, wristPitch];
    const angles = raw.map((value, index) => Math.min(LIMITS[index][1], Math.max(LIMITS[index][0], value)));
    if (angles.some((value, index) => value !== raw[index])) limited = true;
    return { angles, limited, reach: distance / (L1 + L2) };
  };

  const boot = async () => {
    if (!hero || !canvas) return;
    let THREE: typeof import('three');
    try {
      THREE = await import('three');
    } catch {
      hero.classList.add('is-static');
      return;
    }

    let renderer: import('three').WebGLRenderer;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: false, powerPreference: 'high-performance' });
    } catch {
      hero.classList.add('is-static');
      return;
    }

    const NIGHT = 0x0a1322;
    renderer.setClearColor(NIGHT);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = reducedMotion.matches ? 1.1 : 0;

    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(NIGHT, 7, 17);
    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 60);

    scene.add(new THREE.HemisphereLight(0x9fb6d6, 0x0a1322, 0.9));
    const key = new THREE.SpotLight(0xfff3dc, 60, 16, Math.PI / 5, 0.55, 1.6);
    key.position.set(2.2, 6.2, 3.2);
    key.target.position.set(0.4, 0, 0);
    key.castShadow = true;
    key.shadow.mapSize.set(1024, 1024);
    key.shadow.bias = -0.0004;
    key.shadow.radius = 6;
    scene.add(key, key.target);
    const rim = new THREE.DirectionalLight(0x5cc8d6, 2.2);
    rim.position.set(-3, 2.5, -4);
    scene.add(rim);

    // Floor, drafting grid, and the yellow/black safety tape that marks a real work cell.
    const floor = new THREE.Mesh(new THREE.PlaneGeometry(60, 60), new THREE.MeshStandardMaterial({ color: 0x0d1a2c, roughness: 0.92, metalness: 0.05 }));
    floor.rotation.x = -Math.PI / 2;
    floor.receiveShadow = true;
    scene.add(floor);
    const grid = new THREE.GridHelper(24, 48, 0x1f3550, 0x152741);
    grid.position.y = 0.002;
    scene.add(grid);

    const stripe = document.createElement('canvas');
    stripe.width = 64;
    stripe.height = 64;
    const stripeContext = stripe.getContext('2d');
    if (stripeContext) {
      stripeContext.fillStyle = '#111a26';
      stripeContext.fillRect(0, 0, 64, 64);
      stripeContext.fillStyle = '#ffc72c';
      for (let offset = -64; offset < 128; offset += 32) {
        stripeContext.beginPath();
        stripeContext.moveTo(offset, 64);
        stripeContext.lineTo(offset + 16, 64);
        stripeContext.lineTo(offset + 80, 0);
        stripeContext.lineTo(offset + 64, 0);
        stripeContext.fill();
      }
    }
    const tapeTexture = new THREE.CanvasTexture(stripe);
    tapeTexture.colorSpace = THREE.SRGBColorSpace;
    tapeTexture.wrapS = THREE.RepeatWrapping;
    tapeTexture.anisotropy = 4;
    const CELL = 2.6;
    const TAPE = 0.14;
    [0, 1, 2, 3].forEach((side) => {
      const texture = tapeTexture.clone();
      texture.repeat.set(CELL * 2 * 3.2, 1);
      texture.needsUpdate = true;
      const tape = new THREE.Mesh(new THREE.PlaneGeometry(CELL * 2 + TAPE, TAPE), new THREE.MeshStandardMaterial({ map: texture, roughness: 0.7 }));
      tape.rotation.x = -Math.PI / 2;
      tape.rotation.z = (side * Math.PI) / 2;
      const along = side % 2 === 0;
      tape.position.set(along ? 0 : (side === 1 ? CELL : -CELL), 0.004, along ? (side === 0 ? CELL : -CELL) : 0);
      tape.receiveShadow = true;
      scene.add(tape);
    });

    // The arm: a nested transform chain, one group per joint.
    const steel = new THREE.MeshStandardMaterial({ color: 0x223349, metalness: 0.65, roughness: 0.32 });
    const housing = new THREE.MeshStandardMaterial({ color: 0xffc72c, metalness: 0.15, roughness: 0.42 });
    const rubber = new THREE.MeshStandardMaterial({ color: 0x0b111b, roughness: 0.8 });
    const glow = new THREE.MeshBasicMaterial({ color: 0x5cc8d6 });
    const shadowed = (mesh: import('three').Mesh) => { mesh.castShadow = true; mesh.receiveShadow = true; return mesh; };

    const pedestal = shadowed(new THREE.Mesh(new THREE.CylinderGeometry(0.44, 0.5, 0.16, 48), rubber));
    pedestal.position.y = 0.08;
    scene.add(pedestal);
    const yawGroup = new THREE.Group();
    yawGroup.position.y = 0.16;
    scene.add(yawGroup);
    const turret = shadowed(new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.36, 0.34, 48), housing));
    turret.position.y = 0.17;
    yawGroup.add(turret);
    const statusRing = new THREE.Mesh(new THREE.TorusGeometry(0.335, 0.012, 8, 64), glow);
    statusRing.rotation.x = Math.PI / 2;
    statusRing.position.y = 0.06;
    yawGroup.add(statusRing);

    const jointHousing = (radius: number, depth: number) => {
      const mesh = shadowed(new THREE.Mesh(new THREE.CylinderGeometry(radius, radius, depth, 40), housing));
      mesh.rotation.x = Math.PI / 2;
      return mesh;
    };
    const link = (length: number, radius: number) => {
      const mesh = shadowed(new THREE.Mesh(new THREE.CapsuleGeometry(radius, length - radius * 2, 8, 24), steel));
      mesh.rotation.z = -Math.PI / 2;
      mesh.position.x = length / 2;
      return mesh;
    };

    const shoulderGroup = new THREE.Group();
    shoulderGroup.position.y = SHOULDER_H - 0.16;
    yawGroup.add(shoulderGroup);
    shoulderGroup.add(jointHousing(0.2, 0.36), link(L1, 0.11));
    const elbowGroup = new THREE.Group();
    elbowGroup.position.x = L1;
    shoulderGroup.add(elbowGroup);
    elbowGroup.add(jointHousing(0.15, 0.3), link(L2, 0.085));
    const wristGroup = new THREE.Group();
    wristGroup.position.x = L2;
    elbowGroup.add(wristGroup);
    wristGroup.add(jointHousing(0.1, 0.22), link(L3 - 0.08, 0.06));
    const fingerGeometry = new THREE.BoxGeometry(0.12, 0.025, 0.04);
    [-1, 1].forEach((sign) => {
      const finger = shadowed(new THREE.Mesh(fingerGeometry, steel));
      finger.position.set(L3 - 0.04, sign * 0.045, 0);
      wristGroup.add(finger);
    });
    const tip = new THREE.Object3D();
    tip.position.x = L3;
    wristGroup.add(tip);

    // Target: a small beacon, a floor reticle under it, and a beam from the tool tip.
    const beacon = new THREE.Mesh(new THREE.SphereGeometry(0.035, 16, 16), glow);
    scene.add(beacon);
    const reticle = new THREE.Mesh(new THREE.RingGeometry(0.11, 0.13, 48), new THREE.MeshBasicMaterial({ color: 0x5cc8d6, transparent: true, opacity: 0.55 }));
    reticle.rotation.x = -Math.PI / 2;
    reticle.position.y = 0.006;
    scene.add(reticle);
    const beamGeometry = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(), new THREE.Vector3()]);
    const beam = new THREE.Line(beamGeometry, new THREE.LineBasicMaterial({ color: 0x5cc8d6, transparent: true, opacity: 0.6 }));
    scene.add(beam);

    // Layout: on wide screens the arm stands right of the headline; on narrow ones it sits below.
    const focus = new THREE.Vector3();
    const resize = () => {
      const width = hero.clientWidth;
      const height = hero.clientHeight;
      const narrow = width < 1024;
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, narrow ? 1.5 : 2));
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.fov = narrow ? 44 : 34;
      if (narrow) {
        camera.position.set(4.4, 2.8, 10.2);
        focus.set(0.5, -1.2, 0);
      } else {
        camera.position.set(3.0, 2.8, 8.4);
        focus.set(-2.0, 1.15, 0.2);
      }
      camera.lookAt(focus);
      camera.updateProjectionMatrix();
    };
    resize();
    new ResizeObserver(resize).observe(hero);

    // Pointer → target: cast through a vertical plane facing the camera across the work cell.
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    const workPlane = new THREE.Plane();
    const planePoint = new THREE.Vector3(0.6, 0.9, 0.3);
    const target = new THREE.Vector3(1.2, 0.9, 0.5);
    const desired = target.clone();
    let lastInput = -Infinity;
    const aim = (clientX: number, clientY: number) => {
      const bounds = canvas.getBoundingClientRect();
      pointer.set(((clientX - bounds.left) / bounds.width) * 2 - 1, -((clientY - bounds.top) / bounds.height) * 2 + 1);
      raycaster.setFromCamera(pointer, camera);
      const normal = new THREE.Vector3().subVectors(camera.position, planePoint).setY(0).normalize();
      workPlane.setFromNormalAndCoplanarPoint(normal, planePoint);
      const hit = raycaster.ray.intersectPlane(workPlane, new THREE.Vector3());
      if (!hit) return;
      hit.y = Math.max(0.08, Math.min(2.6, hit.y));
      const flat = Math.hypot(hit.x, hit.z);
      if (flat > CELL - 0.15) hit.multiplyScalar((CELL - 0.15) / flat).setY(hit.y);
      desired.copy(hit);
      lastInput = performance.now();
    };
    hero.addEventListener('pointermove', (event) => aim(event.clientX, event.clientY));
    hero.addEventListener('pointerdown', (event) => aim(event.clientX, event.clientY));

    // Joint state is driven by a critically damped spring toward the IK solution,
    // which is what makes the motion read as a heavy, physical arm.
    const angles = [0.3, 1.75, -2.6, 0.9];
    const velocity = [0, 0, 0, 0];
    const STIFFNESS = 38;
    const DAMPING = 2 * Math.sqrt(STIFFNESS);
    let latest = solve(target.x, target.y, target.z);
    if (reducedMotion.matches) latest.angles.forEach((value, index) => { angles[index] = value; });

    const jointNodes = [...hero.querySelectorAll<HTMLElement>('[data-joint]')];
    const barNodes = [...hero.querySelectorAll<HTMLElement>('[data-bar]')];
    const toolNode = hero.querySelector<HTMLElement>('[data-tool]');
    const reachNode = hero.querySelector<HTMLElement>('[data-reach]');
    const stateNode = hero.querySelector<HTMLElement>('[data-ik-state]');
    const readout = hero.querySelector<HTMLElement>('[data-readout]');
    const tipWorld = new THREE.Vector3();
    let lastReadout = 0;
    let previous = performance.now();
    const started = previous;

    const frame = (now: number) => {
      const dt = Math.min(0.033, (now - previous) / 1000);
      previous = now;

      if (!reducedMotion.matches) {
        const power = Math.min(1, (now - started) / 1400);
        renderer.toneMappingExposure = 1.1 * (1 - Math.pow(1 - power, 4));
        if (now - lastInput > 2600) {
          const t = now / 1000;
          desired.set(1.25 + Math.sin(t * 0.42) * 0.55, 0.85 + Math.sin(t * 0.77) * 0.38, 0.35 + Math.cos(t * 0.42) * 0.85);
        }
      }

      target.lerp(desired, reducedMotion.matches ? 1 : 1 - Math.exp(-dt * 9));
      latest = solve(target.x, target.y, target.z);
      latest.angles.forEach((goal, index) => {
        if (reducedMotion.matches) {
          angles[index] = goal;
          return;
        }
        const force = STIFFNESS * (goal - angles[index]) - DAMPING * velocity[index];
        velocity[index] += force * dt;
        angles[index] += velocity[index] * dt;
      });

      yawGroup.rotation.y = angles[0];
      shoulderGroup.rotation.z = angles[1];
      elbowGroup.rotation.z = angles[2];
      wristGroup.rotation.z = angles[3];
      scene.updateMatrixWorld();
      tip.getWorldPosition(tipWorld);

      beacon.position.copy(target);
      reticle.position.set(target.x, 0.006, target.z);
      const positions = beamGeometry.attributes.position as import('three').BufferAttribute;
      positions.setXYZ(0, tipWorld.x, tipWorld.y, tipWorld.z);
      positions.setXYZ(1, target.x, target.y, target.z);
      positions.needsUpdate = true;
      glow.color.setHex(latest.limited ? 0xffc72c : 0x5cc8d6);

      renderer.render(scene, camera);

      if (now - lastReadout > 66) {
        lastReadout = now;
        angles.forEach((value, index) => {
          const degrees = (value * 180) / Math.PI;
          if (jointNodes[index]) jointNodes[index].textContent = `${degrees >= 0 ? '+' : ''}${degrees.toFixed(1)}°`;
          const [min, max] = LIMITS[index];
          if (barNodes[index]) barNodes[index].style.setProperty('--fill', String((value - min) / (max - min)));
        });
        if (toolNode) toolNode.textContent = `${Math.round(tipWorld.x * 1000)}, ${Math.round(tipWorld.y * 1000)}, ${Math.round(tipWorld.z * 1000)}`;
        if (reachNode) reachNode.textContent = String(Math.round(latest.reach * 100));
        const state = latest.limited ? 'limit' : now - lastInput > 2600 && !reducedMotion.matches ? 'idle sweep' : 'tracking';
        if (stateNode) stateNode.textContent = state;
        if (readout) readout.dataset.state = latest.limited ? 'limit' : 'ok';
      }
    };

    // Only render while the hero is on screen.
    let running = false;
    const setRunning = (visible: boolean) => {
      if (visible === running) return;
      running = visible;
      previous = performance.now();
      renderer.setAnimationLoop(visible ? frame : null);
    };
    new IntersectionObserver(([entry]) => setRunning(entry.isIntersecting), { threshold: 0 }).observe(hero);
    document.addEventListener('visibilitychange', () => setRunning(!document.hidden && hero.getBoundingClientRect().bottom > 0));
    hero.classList.add('is-live');
  };

  void boot();
</script>
