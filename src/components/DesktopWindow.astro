---
import SystemModel from './SystemModel.astro';
import ApplicationExperience from './ApplicationExperience.astro';

interface Props {
  id: string;
  title: string;
  icon: string;
  class?: string;
  open?: boolean;
}

const { id, title, icon, class: className = '', open = false } = Astro.props;
const modelByWindow: Record<string, 'waybionic' | 'blackbox' | 'rover' | 'hvac' | 'roadmap'> = {
  portfolio: 'roadmap', waybionic: 'waybionic', blackbox: 'blackbox', rover: 'rover', resume: 'roadmap', about: 'roadmap',
  browser: 'roadmap', calculator: 'blackbox', recycle: 'blackbox', games: 'roadmap', system: 'roadmap', work: 'roadmap',
  skills: 'roadmap', research: 'blackbox', notes: 'roadmap', terminal: 'blackbox', media: 'waybionic', restore: 'blackbox',
  hvacsim: 'hvac', rosgraph: 'waybionic', monitor: 'blackbox', oldarm: 'waybionic', filesystem: 'blackbox'
};
const model = modelByWindow[id];
---

<section class={`os-window ${className}`} data-window={id} aria-label={`${title} window`} hidden={!open}>
  <header class="window-titlebar">
    <span class="window-title"><span aria-hidden="true">{icon}</span>{title}</span>
    <span class="window-controls">
      <button type="button" data-window-minimize={id} aria-label={`Minimize ${title}`}>_</button>
      <button type="button" data-window-maximize={id} aria-label={`Maximize ${title}`}>□</button>
      <button type="button" data-window-close={id} aria-label={`Close ${title}`}>×</button>
    </span>
  </header>
  {model ? <div class="window-model-rail"><SystemModel kind={model} /><span class="window-model-caption mono">CONCEPT MODEL / {model.toUpperCase()} / LIVE VIEW</span></div> : null}
  {id !== 'field' ? <ApplicationExperience id={id} /> : null}
  <div class="window-content">
    <slot />
  </div>
  <footer class="window-statusbar mono"><span>LOCAL / READY</span><span>{id.toUpperCase()} / PUBLIC VIEW</span></footer>
</section>