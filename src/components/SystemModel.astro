---
interface Props {
  kind: 'waybionic' | 'blackbox' | 'rover' | 'hvac' | 'roadmap';
}

const { kind } = Astro.props;
---

<div class="diagram-model" data-system-model={kind} aria-hidden="true">
  <canvas class="diagram-model-canvas" data-system-model-canvas></canvas>
  <span class="diagram-model-label mono">CONCEPTUAL MODEL</span>
</div>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvases = document.querySelectorAll<HTMLCanvasElement>('[data-system-model-canvas]:not([data-model-ready])');

  if (!reduced) {
    canvases.forEach((canvas) => {
      const host = canvas.closest<HTMLElement>('[data-system-model]');
      const kind = host?.dataset.systemModel;
      if (!host || !kind) return;
      canvas.dataset.modelReady = 'true';

      const start = async () => {
        try {
          const THREE = await import('three');
          const scene = new THREE.Scene();
          const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 30);
          camera.position.set(3.1, 2.3, 4.8);
          camera.lookAt(0, 0.35, 0);
          const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
          renderer.setPixelRatio(Math.min(devicePixelRatio, 1.25));
          scene.add(new THREE.HemisphereLight(0xdff8ff, 0x102436, 1.7));
          const key = new THREE.DirectionalLight(0xd8ed77, 2.2);
          key.position.set(3, 4, 3);
          scene.add(key);
          const group = new THREE.Group();
          const metal = new THREE.MeshStandardMaterial({ color: 0x69bced, roughness: 0.34, metalness: 0.35 });
          const dark = new THREE.MeshStandardMaterial({ color: 0x173f52, roughness: 0.48, metalness: 0.3 });
          const accent = new THREE.MeshStandardMaterial({ color: 0xd8ed77, emissive: 0x456321, emissiveIntensity: 0.35, roughness: 0.3 });
          const addLink = (startPoint: InstanceType<typeof THREE.Vector3>, endPoint: InstanceType<typeof THREE.Vector3>, radius = 0.055) => {
            const direction = endPoint.clone().sub(startPoint);
            const link = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius * 1.2, direction.length(), 10), metal);
            link.position.copy(startPoint.clone().add(endPoint).multiplyScalar(0.5));
            link.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), direction.normalize());
            group.add(link);
          };

          if (kind === 'waybionic') {
            const points = [new THREE.Vector3(-0.85, -0.3, 0), new THREE.Vector3(-0.55, 0.45, 0), new THREE.Vector3(0.1, 0.82, 0), new THREE.Vector3(0.65, 1.38, 0)];
            points.forEach((point) => { const joint = new THREE.Mesh(new THREE.SphereGeometry(0.11, 12, 12), accent); joint.position.copy(point); group.add(joint); });
            points.slice(0, -1).forEach((point, index) => addLink(point, points[index + 1], 0.07));
          } else if (kind === 'rover') {
            const body = new THREE.Mesh(new THREE.BoxGeometry(1.45, 0.42, 0.9), metal);
            body.position.y = 0.18;
            group.add(body);
            const sensor = new THREE.Mesh(new THREE.CylinderGeometry(0.18, 0.18, 0.14, 16), accent);
            sensor.rotation.x = Math.PI / 2;
            sensor.position.set(0.25, 0.48, 0);
            group.add(sensor);
            [-0.62, 0.62].forEach((x) => [-0.43, 0.43].forEach((z) => { const wheel = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 0.12, 16), dark); wheel.rotation.x = Math.PI / 2; wheel.position.set(x, -0.18, z); group.add(wheel); }));
          } else if (kind === 'blackbox') {
            const vault = new THREE.Mesh(new THREE.BoxGeometry(1.25, 1.05, 1.05), dark);
            group.add(vault);
            const frame = new THREE.LineSegments(new THREE.EdgesGeometry(new THREE.BoxGeometry(1.45, 1.25, 1.25)), new THREE.LineBasicMaterial({ color: 0xd8ed77, transparent: true, opacity: 0.9 }));
            group.add(frame);
            const seal = new THREE.Mesh(new THREE.TorusGeometry(0.22, 0.035, 8, 24), accent);
            seal.position.z = 0.56;
            group.add(seal);
          } else if (kind === 'hvac') {
            const housing = new THREE.Mesh(new THREE.CylinderGeometry(0.78, 0.78, 0.42, 24), metal);
            housing.rotation.z = Math.PI / 2;
            group.add(housing);
            for (let index = 0; index < 4; index += 1) { const blade = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.58, 0.08), accent); blade.position.z = 0.28; blade.rotation.z = index * Math.PI / 2; group.add(blade); }
          } else {
            const points = [-0.9, 0, 0.9].map((x, index) => new THREE.Vector3(x, index === 1 ? 0.45 : 0, 0));
            points.forEach((point) => { const node = new THREE.Mesh(new THREE.SphereGeometry(0.14, 12, 12), accent); node.position.copy(point); group.add(node); });
            addLink(points[0], points[1]);
            addLink(points[1], points[2]);
          }

          const base = new THREE.Mesh(new THREE.CylinderGeometry(1.05, 1.05, 0.04, 24), dark);
          base.position.y = -0.5;
          group.add(base);
          scene.add(group);
          const resize = () => { const bounds = canvas.getBoundingClientRect(); renderer.setSize(bounds.width, bounds.height, false); camera.aspect = bounds.width / Math.max(bounds.height, 1); camera.updateProjectionMatrix(); };
          resize();
          const resizeObserver = new ResizeObserver(resize);
          resizeObserver.observe(host);
          addEventListener('resize', resize);
          const animate = (time: number) => { group.rotation.y = time * 0.00018; group.position.y = Math.sin(time * 0.0012) * 0.035; renderer.render(scene, camera); requestAnimationFrame(animate); };
          requestAnimationFrame(animate);
        } catch {
          host.classList.add('model-fallback');
        }
      };
      if ('requestIdleCallback' in window) requestIdleCallback(start); else setTimeout(start, 500);
    });
  }
</script>
